    private bool CheckInvoicePaymentStatus(int? paymentMethodId)
    {
        if (this.Invoice is not null && paymentMethodId > 0 && listPaymentMethod is not null)
        {
            var paymentMethod = listPaymentMethod.FirstOrDefault(p => p.PaymentMethodId == paymentMethodId);
            if (paymentMethod is not null) return paymentMethod.IsPayment;
        }
        return false;
    }
