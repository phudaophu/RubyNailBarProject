@inject IUsersService UsersService
@inject IJSRuntime JSRuntime
@inject IInvoicesService InvoicesService
@inject ICustomersService CustomersService
@inject ContainerStorage ContainerStorage
@inject NavigationManager NavigationManager
@inject IPaymentMethodsService PaymentMethodsService
@inject IStoresService StoresService

@if (this.Invoice is not null)
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>
                    Store
                </th>
                <th>
                    Manager
                </th>
                <th>
                    Payment
                </th>
                <th>
                    Customer
                </th>
                <th>
                </th>
                <th>
                </th>
                <th>
                </th>
                <th>
                </th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>
                    <InputSelect class="form-select" TValue="int?"
                                 Value="Invoice.StoreId"
                                 ValueChanged="@( (int? e) => {OnSelectStoreChanged(e);} )"
                                 ValueExpression="@(() => Invoice.StoreId)">

                        <option value="0" disabled selected>-- Select Store --</option>
                        @if (listStores != null && listStores.Any())
                        {
                            @if (this.Invoice.InvoiceId > 0)
                            {
                                @foreach (var store in listStores)
                                {
                                    <option value="@store.StoreId" disabled="@(Invoice.InvoiceId > 0)">@store.Name</option>

                                }

                            }
                            @if (this.Invoice.InvoiceId <= 0)
                            {
                                @foreach (var store in listStores.Where(s => s.IsActive == true).ToList())
                                {
                                    <option value="@store.StoreId" disabled="@(Invoice.InvoiceId > 0)">@store.Name</option>

                                }
                            }
                        }

                    </InputSelect>
                </td>
                <td>

                    <InputSelect class="form-select" TValue="int?"
                                 Value="Invoice.ManagerId"
                                    ValueChanged="@( (int? e) => {OnSelectManagerChanged(e);} )"
                                 ValueExpression="@(() => Invoice.ManagerId)">

                        <option value="0" disabled selected>--Select Manager--</option>
                        @if (listManagers != null && listManagers.Any())
                        {
                            @foreach (var manager in listManagers)
                            {
                                <option value="@manager.UserId" disabled="@(manager.IsDeleted || @manager.IsActive)">@manager.FirstName @manager.LastName</option>

                            }

                        }
                    </InputSelect>
                </td>
                <td>
                    <InputSelect class="form-select" TValue="int?"
                                 Value="Invoice.PaymentMethodId"
                                     ValueChanged="@(async (int? e) => {await OnSelectPaymentMethodChanged(e);} )"
                                 ValueExpression="@(() => Invoice.PaymentMethodId)">
                       
                        @if ((this.Invoice.InvoiceId <= 0) && listPendingPayment != null && listPendingPayment.Any())
                        {

                            @foreach (var paymentMethod in listPendingPayment)
                            {
                                <option value="@paymentMethod.PaymentMethodId">@paymentMethod.Name</option>
                            }

                        }
                        else if ((this.Invoice.InvoiceId > 0) && listPaymentMethod != null && listPaymentMethod.Any())
                        {
                            @foreach (var paymentMethod in listPaymentMethod)
                            {
                                <option value="@paymentMethod.PaymentMethodId">@paymentMethod.Name</option>
                            }
                        }
                    </InputSelect>
                </td>
                <td>
                    <input type="text" class="form-control" placeholder="Enter PhoneNo | Name" @bind="searchText" disabled="@(this.Invoice.InvoiceId > 0)" />
                    @if (listFoundCustomers?.Any() == true)
                    {
                        <ul class="list-group position-absolute mt-1" style="z-index:1000; width:300px">

                            @foreach (var customer in listFoundCustomers)
                            {
                                <li style="@(customer.IsDeleted ? "pointer-events: none" : null)"
                                    class="list-group-item list-group-item-action @(customer.IsDeleted ? "text-decoration-line-through text-danger" : "")"
                                    aria-disabled="@(customer.IsDeleted ? "true" : null)"
                                    @onclick="() => { if (!customer.IsDeleted) HandleSelectCustomer(customer); }">

                                    @customer.Name - @customer.PhoneNo
                                    @((customer.Birthday is DateOnly b) ? $" - {b:MMM dd}" : null)
                                </li>
                            }
                        </ul>
                     }
                </td>

                @if (this.Invoice.InvoiceId > 0)
                {
                    @* @if (isManagerChanged || isPaymentMethodChanged || isDescriptionChanged || isInvoiceBookingTypeChanged || isInvoiceServicesAmountChanged 
                                                    || isInvoiceTipAmountChanged || isGSTaxChanged || isPSTaxChanged || isInvoiceImportantChanged || isAppliedDiscountChanged) *@
                    @if(IsInvoiceInfoChanged())
                    {
                        <td class="align-middle">
                            <button type="button" title="Update Invoice" class="bg-transparent border-2 border-light p-0" @onclick="HandleUpdateInvoiceButton">💾</button>
                        </td>
                        <td class="align-middle">
                            <button type="button" title="Advanced Settings" class="bg-transparent border-2 border-light p-0" @onclick="HandleAddAdvancedSettingsSection">🛠️</button>
                        </td>
                        <td class="align-middle" colspan="2">
                            <button type="button" title="Discard Update" class="bg-transparent border-2 border-light p-0" @onclick="HandleDiscardUpdateInvoiceButton">🚫</button>
                        </td>
                    }
                    else
                    {
                        <td class="align-middle">
                            <button type="button" title="Update Invoice" class="bg-transparent border-2 border-light p-0" @onclick="HandleUpdateInvoiceButton" disabled>💾</button>
                        </td>
                        <td class="align-middle">
                            <button type="button" title="Advanced Settings" class="bg-transparent border-2 border-light p-0" @onclick="HandleAddAdvancedSettingsSection">🛠️</button>
                        </td>
                        <td class="align-middle" colspan="2">
                            <button type="button" title="Add Services" class="bg-transparent border-2 border-light p-0" @onclick="HandleAddInvoiceDetailButton">➕</button>
                        </td>


                    }
                }
                else
                {
                    <td class="align-middle">
                        @if (this.Invoice.CustomerId > 0)
                        {
                            <button type="button" title="Discard Customer" class="bg-transparent border-2 border-light p-0" @onclick="HandleClearCustomerSelectionButton" disabled="@(this.Invoice.InvoiceId > 0)">❌</button>

                        }
                        else 
                        {
                            if (listFoundCustomers is null || listFoundCustomers?.Count == 0)
                            {
                                <button type="button" title="Search Customer" class="bg-transparent border-2 border-light p-0" @onclick="HandleSearchButton">🔍</button>
                            }
                            else
                            {
                                <button type="button" title="Search Customer" class="bg-transparent border-2 border-light p-0" @onclick="HandleClearSearchButton">↩️</button>

                            }

                        }

                    </td>
                    <td class="align-middle">
                        @if (activeAddCustomerSection)
                        {
                            <button type="button" title="Dont Add Customer" class="bg-transparent border-2 border-light p-0" @onclick="HandleAddNewCustomerButton">🚫</button>

                        }
                        else
                        {
                            <button type="button" title="Add New Customer" class="bg-transparent border-2 border-light p-0" @onclick="HandleAddNewCustomerButton">👤</button>

                        }
                    </td>

                    <td class="align-middle">
                        <button type="button" title="Advanced Settings" class="bg-transparent border-2 border-light p-0" @onclick="HandleAddAdvancedSettingsSection">🛠️</button>
                    </td>

                    <td class="align-middle">
                        <button type="button" title="Add Invoice" class="bg-transparent border-2 border-light p-0" @onclick="HandleAddInvoiceButton"
                                disabled="@(Invoice.CustomerId > 0 && Invoice.StoreId > 0 && Invoice.ManagerId > 0 ? false : true)">
                            ✔️
                        </button>
                    </td>

                }



            </tr>
        </tbody>
    </table>

    // Advanced Settings
    @if (activeAddAdvacedSettingsSection && this.Invoice is not null)
    {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>
                        Total Services
                    </th>
                    <th>
                        Tip
                    </th>
                    <th>
                        Discount
                    </th>
                    <th>
                        GST
                    </th>
                    <th>
                        PST 
                    </th>
                    <th>
                        Booking via
                    </th>
                    <th>
                        Description
                    </th>
                    <th></th>
                    <th></th>
                    

                </tr>
            </thead>
@*             private bool isTotalBillChanged = false;

            private bool isInvoiceTipChanged = false;

            private bool isGSTaxChanged = false;

            private bool isPSTaxChanged = false; *@
            <tbody>
                <tr>
                    <td class="align-middle">
                        <InputNumber class="form-control"
                                     TValue="decimal?"
                                     Value="Invoice.ServicesAmount"
                                     ValueChanged="@( (decimal? e) => {OnInvoiceServicesFeeChanged(e);} )"
                                     ValueExpression="@(() => Invoice.ServicesAmount)"
                                     min="0" disabled="@(invoicePaymentStatus)">
                        </InputNumber>
                    </td>
                    <td class="align-middle">

                        <InputNumber class="form-control" 
                                     TValue="decimal?"
                                     Value="Invoice.TipAmount"
                                     ValueChanged="@( (decimal? e) => {OnInvoiceTipAmountChanged(e);} )"
                                     ValueExpression="@(() => Invoice.TipAmount)"
                                     min="0" disabled="@(invoicePaymentStatus)">

                        </InputNumber>
                    </td>

                    <td class="align-middle">

                        <div class="input-group input-group flex-nowrap">
                            <InputNumber TValue="decimal?" class="form-control text-end"
                                         Value="Invoice.Discount"
                                         ValueChanged="@( (decimal? e) => {OnAppliedDiscountChanged(e);} )"
                                         ValueExpression="@(() => Invoice.Discount)"
                                         step="0.1" min="0" max="100" disabled="@(invoicePaymentStatus)" />
                            <span class="input-group-text">%</span>
                        </div>
                    </td>

                    <td class="align-middle">
                        <div class="input-group input-group flex-nowrap">
                            <InputNumber TValue="decimal?" class="form-control text-end"
                                         Value="Invoice.GSTax"
                                         ValueChanged="@( (decimal? e) => {OnGSTaxChanged(e);} )"
                                         ValueExpression="@(() => Invoice.GSTax)"
                                         step="0.1" min="0" max="100" disabled="@(invoicePaymentStatus)" />
                            <span class="input-group-text">%</span>
                        </div>
                    </td>
                    <td class="align-middle input-group w-auto">
                        <div class="input-group input-group flex-nowrap">
                            <InputNumber TValue="decimal?" class="form-control text-end"
                                         Value="Invoice.PSTax"
                                         ValueChanged="@( (decimal? e) => {OnPSTaxChanged(e);} )"
                                         ValueExpression="@(() => Invoice.PSTax)"
                                         step="0.1" min="0" max="100" disabled="@(invoicePaymentStatus)" />
                            <span class="input-group-text">%</span>
                        </div>
                    </td>
                    <td class="align-middle">
                        <InputSelect class="form-select"
                                     Value="Invoice.BookingType"
                                     ValueChanged="@( (string? e) => {OnSelectInvoiceTypeChanged(e);} )"
                                     ValueExpression="@(() => Invoice.BookingType)">

                            <option value="" disabled selected>-Select Type-</option>
                            @if (listInvoiceBookingTypes != null && listInvoiceBookingTypes.Any())
                            {
                                @foreach (var bookingType in listInvoiceBookingTypes)
                                {
                                    <option value="@bookingType">@bookingType</option>

                                }

                            }
                        </InputSelect>
                    </td>
                    <td class="align-middle" colspan="2">
                        <InputText type="text" class="form-control" placeholder="Enter Description"
                                   Value="@Invoice.Description"
                                   ValueChanged="@((string e) => { OnInvoiceDescriptionChange(e);} )"
                                   ValueExpression="@(() => Invoice.Description)" />
                    </td>

                    <td class="align-middle">
                        @if (!Invoice.IsImportant)
                        {
                            <button type="button" title="Save to Watchlist" class="bg-transparent border-2 border-light p-0" @onclick="HandleMoveToWatchlist">
                                📌
                            </button>
                        }else{
                            <button type="button" title="Remove from Watchlist" class="bg-transparent border-2 border-light p-0" @onclick="HandleMoveToWatchlist">
                                ✂
                            </button>
                        }

                    </td>
                </tr>
            </tbody>
        </table>
    }
   
}

<hr>





@code {

    // [Parameter]
    // public EventCallback<Invoice> InvoiceCallBack { get; set; }

    [Parameter]
    public EventCallback<bool> AddCustomerSectionCallBack { get; set; }

    [Parameter]
    public EventCallback<bool> OnChangeInvoicePaymentStatusCallBack { get; set; }

    [Parameter]
    public EventCallback<bool> AddAdvancedSettingsSectionCallBack { get; set; }

    [Parameter]
    public EventCallback OnChangeInvoiceTotalBillCallBack { get; set; }

    [Parameter]
    public string CurrentPath { get; set; } = string.Empty;

    [Parameter]
    public Invoice? Invoice { get; set; }

    [Parameter]
    public EventCallback<bool> InvoiceInfoChangedButNotSaveCallBack { get; set; }

    private List<User> listManagers = new List<User>();

    private List<Store> listStores = new List<Store>();

    private List<PaymentMethod>? listPendingPayment = new List<PaymentMethod>();

    private List<PaymentMethod>? listPaymentMethod = new List<PaymentMethod>();

    private List<string>? listInvoiceBookingTypes = new List<string>();

    private string? searchText { get; set; } = string.Empty;

    private List<Customer>? listFoundCustomers = new List<Customer>();

    private bool isManagerChanged = false;

    private bool isPaymentMethodChanged = false;

    private bool isDescriptionChanged = false;

    private bool isInvoiceBookingTypeChanged = false;

    private bool isInvoiceServicesAmountChanged = false;

    private bool isInvoiceTipAmountChanged = false;

    private bool isGSTaxChanged = false;

    private bool isPSTaxChanged = false;

    private bool isInvoiceImportantChanged = false;

    private bool isAppliedDiscountChanged = false;

    [Parameter]
    public bool activeAddCustomerSection { get; set; } = false;

    private bool activeAddAdvacedSettingsSection = false;

    private int? snapshotPaymentMethodId;

    private int? snapshotManagerId;

    private string snapshotDescription = string.Empty;

    private string snapshotInvoiceType = string.Empty;

    private decimal? snapshotInvoiceServicesAmount;

    private decimal? snapshotInvoiceTipAmount;

    private decimal? snapshotGSTax; 

    private decimal? snapshotPSTax; 

    private decimal? snapshotAppliedDiscount; 

    private bool snapshotInvoiceImportant; 

    private int? selectedInvoiceDetailId;

    private Customer? selectedCustomerInfo = new Customer();

    private bool invoicePaymentStatus = false;



    protected override void OnInitialized()
    {
        listStores = StoresService.GetActiveStoresService();

        listPaymentMethod = PaymentMethodsService.GetPaymentMethodsService();

        listInvoiceBookingTypes = InvoicesService.GetInvoiceBookingTypesService();

        listPendingPayment = listPaymentMethod.Where(p => p.IsPayment == false).ToList();

        this.selectedInvoiceDetailId = ContainerStorage.GetLastSelectedRecordId(this.CurrentPath);

        if(this.Invoice is not null)
        {
            if (Invoice.PaymentMethodId > 0) snapshotPaymentMethodId = Invoice.PaymentMethodId;

            if(Invoice.ManagerId > 0) snapshotManagerId = Invoice.ManagerId;

            snapshotDescription = Invoice.Description ?? String.Empty;

            snapshotInvoiceType = Invoice.BookingType ?? String.Empty;

            snapshotInvoiceServicesAmount = Invoice.ServicesAmount ?? 0;

            snapshotInvoiceTipAmount = Invoice.TipAmount ?? 0;

            snapshotGSTax = Invoice.GSTax ?? InvoicesService.GetGoodsAndServicesTaxValue();

            snapshotPSTax = Invoice.PSTax ?? InvoicesService.GetProvincialSalesTaxValue();

            snapshotAppliedDiscount = Invoice.Discount ?? InvoicesService.GetAppliedDiscount();

            snapshotInvoiceImportant = Invoice.IsImportant;

        }
    }

    protected override void OnParametersSet()
    {
        if (this.Invoice is not null)
        {
            if (Invoice.InvoiceId > 0)
            {
                if (Invoice.StoreId > 0 && !listManagers.Any())
                {
                    listManagers = UsersService.GetManagerListByStoreIdService(Invoice.StoreId.Value);
                }   

                invoicePaymentStatus = CheckInvoicePaymentStatus(Invoice.PaymentMethodId);
            }

            // if (Invoice.InvoiceId <= 0)
            // {
            //     Invoice.PaymentMethodId = listPaymentMethod?.FirstOrDefault(p => p.IsPayment == false)?.PaymentMethodId;
            // }

            if (Invoice.CustomerId > 0)
            {
                selectedCustomerInfo = CustomersService.GetCustomerByIdService(Invoice.CustomerId.Value);

                searchText = $"{selectedCustomerInfo?.Name} - {selectedCustomerInfo?.PhoneNo}";
            }
        }
    }

    private (string status, string emoji, int rank) CheckInvoieDetailStatus(InvoiceDetail? invoiceDetail)
    {
        return ContainerStorage.CheckInvoieDetailStatus(invoiceDetail);

    }


    private bool IsInvoiceInfoChanged()
    {
        if(isManagerChanged || isPaymentMethodChanged || isDescriptionChanged 
                    || isInvoiceBookingTypeChanged || isInvoiceServicesAmountChanged
                                        || isInvoiceTipAmountChanged || isGSTaxChanged || isPSTaxChanged 
                                                        || isInvoiceImportantChanged || isAppliedDiscountChanged)
        {
            return true;
        }
        return false;
    }

    private void OnAppliedDiscountChanged(decimal? valueChanged)
    {
        if(Invoice is not null && valueChanged >= 0)
        {
            Invoice.Discount = valueChanged;
            isAppliedDiscountChanged = true;
            OnChangeInvoiceTotalBillCallBack.InvokeAsync();

            if (Invoice is not null && Invoice.InvoiceId > 0) 
                InvoiceInfoChangedButNotSaveCallBack.InvokeAsync(true);
        }
    }

    private void OnInvoiceTipAmountChanged(decimal? valueChanged)
    {
        if (Invoice is not null && valueChanged >= 0)
        {
            Invoice.TipAmount = valueChanged;
            isInvoiceTipAmountChanged = true;
            OnChangeInvoiceTotalBillCallBack.InvokeAsync();

            if (Invoice is not null && Invoice.InvoiceId > 0)
                InvoiceInfoChangedButNotSaveCallBack.InvokeAsync(true);
        }
    }

    private void OnGSTaxChanged(decimal? valueChanged)
    {
        if (Invoice is not null && valueChanged >= 0)
        {
            Invoice.GSTax = valueChanged;
            isGSTaxChanged = true;
            OnChangeInvoiceTotalBillCallBack.InvokeAsync();

            if (Invoice is not null && Invoice.InvoiceId > 0)
                InvoiceInfoChangedButNotSaveCallBack.InvokeAsync(true);

        }
    }

    private void OnPSTaxChanged(decimal? valueChanged)
    {
        if (Invoice is not null && valueChanged >= 0)
        {
            Invoice.PSTax = valueChanged;
            isPSTaxChanged = true;
            OnChangeInvoiceTotalBillCallBack.InvokeAsync();

            if (Invoice is not null && Invoice.InvoiceId > 0)
                InvoiceInfoChangedButNotSaveCallBack.InvokeAsync(true);

        }
    }

    private void OnInvoiceServicesFeeChanged(decimal? valueChanged)
    {
        if(Invoice is not null && valueChanged >= 0)
        {
            Invoice.ServicesAmount = valueChanged;
            isInvoiceServicesAmountChanged = true; 
            OnChangeInvoiceTotalBillCallBack.InvokeAsync();

            if (Invoice is not null && Invoice.InvoiceId > 0)
                InvoiceInfoChangedButNotSaveCallBack.InvokeAsync(true);
        }
    }

    private void OnSelectInvoiceTypeChanged(string? valueChanged)
    {
        if (Invoice is not null)
        {
            Invoice.BookingType = valueChanged;
            isInvoiceBookingTypeChanged = true;

            if (Invoice is not null && Invoice.InvoiceId > 0)
                InvoiceInfoChangedButNotSaveCallBack.InvokeAsync(true);
        }
    }

    private void HandleMoveToWatchlist()
    {
        if (this.Invoice is not null)
        {
            Invoice.IsImportant = !Invoice.IsImportant;
            isInvoiceImportantChanged = true;

            if (Invoice is not null && Invoice.InvoiceId > 0)
                InvoiceInfoChangedButNotSaveCallBack.InvokeAsync(true);
        }
    }

    private void OnSelectStoreChanged(int? valueChanged)
    {
        if (valueChanged is not null && valueChanged.Value > 0 && valueChanged != this.Invoice?.StoreId && this.Invoice is not null)
        {
            this.Invoice.StoreId = valueChanged.Value;
            this.Invoice.ManagerId = 0;
            listManagers = UsersService.GetManagerListByStoreIdService(valueChanged.Value);

        }

    }



    public void HandleUpdateInvoiceButton()
    {
        if (this.Invoice is not null)
        {
            Invoice.ModifiedDatetime = DateTime.Now;
            InvoicesService.UpdateInvoiceService(Invoice.InvoiceId, Invoice);

            isManagerChanged = false;
            isPaymentMethodChanged = false;
            isDescriptionChanged = false;
            isInvoiceBookingTypeChanged = false;
            isInvoiceServicesAmountChanged = false;
            isInvoiceTipAmountChanged = false;
            isGSTaxChanged = false;
            isPSTaxChanged = false;
            isInvoiceImportantChanged = false;

            if (Invoice is not null && Invoice.InvoiceId > 0)
                InvoiceInfoChangedButNotSaveCallBack.InvokeAsync(false);
        }
    }

    private void HandleSelectCustomer(Customer customer)
    {
        if (customer is not null && this.Invoice is not null)
        {
            searchText = $"{customer.Name} - {customer.PhoneNo}";

            Invoice.CustomerId = customer.CustomerId;
            listFoundCustomers?.Clear();
        }
    }

    private async Task OnSelectPaymentMethodChanged(int? valueChanged)
    {
        if (valueChanged is not null && valueChanged.Value > 0 && valueChanged != Invoice?.PaymentMethodId && this.Invoice is not null)
        {
            if (listPaymentMethod is not null && listPaymentMethod.Where(p => p.IsPayment == true).Any(p => p.PaymentMethodId == valueChanged.Value))
            {
                if (!(this.Invoice.InvoiceId > 0))
                {
                    await JSRuntime.InvokeVoidAsync("confirm", $"⚠️ Payment cannot process due to no services.");
                    //ChangeInvoicePaymentMethodToPending(invoice);
                    await OnChangeInvoicePaymentStatusCallBack.InvokeAsync(false);
                    return;
                }
                else if (Invoice.InvoiceDetails.All(id => id.IsDeleted == true))
                {
                    await JSRuntime.InvokeVoidAsync("alert", $"⚠️ Payment cannot process due to no services.");
                    //ChangeInvoicePaymentMethodToPending(invoice);
                    await OnChangeInvoicePaymentStatusCallBack.InvokeAsync(false);
                    return;
                }
                else if (Invoice.InvoiceDetails.Any()
                                        && Invoice.InvoiceDetails.Any(id => id.IsDeleted == false
                                                                        && !ContainerStorage.CheckInvoieDetailStatus(id).status.Equals("Completed", StringComparison.OrdinalIgnoreCase)))
                {
                    await JSRuntime.InvokeVoidAsync("alert", $"⚠️ All Services must be in COMPLETED status prior to payment process.");
                    //ChangeInvoicePaymentMethodToPending(invoice);
                    await OnChangeInvoicePaymentStatusCallBack.InvokeAsync(false);
                    return;
                }
                // Payment => Completed
                if (Invoice.InvoiceDetails.Any()
                                        && Invoice.InvoiceDetails.Where(id => id.IsDeleted == false).All(id => ContainerStorage.CheckInvoieDetailStatus(id).status.Equals("Completed", StringComparison.OrdinalIgnoreCase)))
                {
                    Invoice.PaymentMethodId = valueChanged.Value;
                    invoicePaymentStatus = CheckInvoicePaymentStatus(valueChanged.Value);
                    await OnChangeInvoicePaymentStatusCallBack.InvokeAsync(invoicePaymentStatus);

                    isPaymentMethodChanged = true;
                    await InvoiceInfoChangedButNotSaveCallBack.InvokeAsync(true);
                    //ContainerStorage.SetOptionalData(this.CurrentPath, "Invoice", Invoice);

                    return;
                }
            }
            // Payment => Pending
            if (listPaymentMethod is not null && listPaymentMethod.Where(p => p.IsPayment == false).Any(p => p.PaymentMethodId == valueChanged.Value))
            {
                Invoice.PaymentMethodId = valueChanged.Value;
                invoicePaymentStatus = CheckInvoicePaymentStatus(valueChanged.Value);
                await OnChangeInvoicePaymentStatusCallBack.InvokeAsync(invoicePaymentStatus);

                isPaymentMethodChanged = true;
                if (Invoice is not null && Invoice.InvoiceId > 0)
                    await InvoiceInfoChangedButNotSaveCallBack.InvokeAsync(true);

                //ContainerStorage.SetOptionalData(this.CurrentPath, "Invoice", Invoice);

                return;
            }
        }
    }


    private void OnSelectManagerChanged(int? valueChanged)
    {
        if (valueChanged is not null && valueChanged.Value > 0 && valueChanged != Invoice?.ManagerId && Invoice is not null)
        {
            Invoice.ManagerId = valueChanged.Value;
            isManagerChanged = true;
            if (Invoice is not null && Invoice.InvoiceId > 0)
                InvoiceInfoChangedButNotSaveCallBack.InvokeAsync(true);
        }
    }

    private void OnInvoiceDescriptionChange(string valueChanged)
    {
        if (Invoice is not null)
        {
            Invoice.Description = valueChanged;
            isDescriptionChanged = true;

            if (Invoice is not null && Invoice.InvoiceId > 0)
                InvoiceInfoChangedButNotSaveCallBack.InvokeAsync(true);
        }
    }


    private void HandleAddInvoiceButton()
    {
        if (this.Invoice is not null && Invoice.CustomerId > 0 && Invoice.StoreId > 0 && Invoice.ManagerId > 0)
        {
            int newInvoiceId = InvoicesService.AddInvoiceService(Invoice);

            ContainerStorage.ResetPaginationData(this.CurrentPath);

            ContainerStorage.SetSelectedRecordId("invoices", newInvoiceId);

            NavigationManager.NavigateTo($"/invoice/{newInvoiceId}");
        }
    }


    private void HandleAddAdvancedSettingsSection()
    {
        activeAddAdvacedSettingsSection = !activeAddAdvacedSettingsSection;
        AddAdvancedSettingsSectionCallBack.InvokeAsync(activeAddAdvacedSettingsSection);

    }

    private void HandleDiscardUpdateInvoiceButton( )
    {
        if (this.Invoice is not null)
        {
            if (snapshotManagerId > 0)
            {
                Invoice.ManagerId = snapshotManagerId;
            }

            if (snapshotPaymentMethodId > 0)
            {
                Invoice.PaymentMethodId = snapshotPaymentMethodId;
                invoicePaymentStatus = CheckInvoicePaymentStatus(snapshotPaymentMethodId);
                OnChangeInvoicePaymentStatusCallBack.InvokeAsync(invoicePaymentStatus);
            }

            Invoice.Description = snapshotDescription ?? String.Empty;
            Invoice.BookingType = snapshotInvoiceType ?? String.Empty;
            Invoice.ServicesAmount = snapshotInvoiceServicesAmount ?? 0;
            Invoice.TipAmount = snapshotInvoiceTipAmount ?? 0;
            Invoice.GSTax = snapshotGSTax ?? InvoicesService.GetGoodsAndServicesTaxValue();
            Invoice.PSTax = snapshotPSTax ?? InvoicesService.GetProvincialSalesTaxValue();
            Invoice.IsImportant = snapshotInvoiceImportant;
            Invoice.Discount = snapshotAppliedDiscount;

            isManagerChanged = false;
            isPaymentMethodChanged = false;
            isDescriptionChanged = false;
            isInvoiceBookingTypeChanged = false;
            isInvoiceServicesAmountChanged = false;
            isInvoiceTipAmountChanged = false;
            isGSTaxChanged = false;
            isPSTaxChanged = false;
            isInvoiceImportantChanged = false;
            isAppliedDiscountChanged = false;

            InvoiceInfoChangedButNotSaveCallBack.InvokeAsync(false);
            OnChangeInvoiceTotalBillCallBack.InvokeAsync();
        }
    }

    private async Task HandleAddInvoiceDetailButton( )
    {
        if (listPaymentMethod is not null && this.Invoice is not null)
        {
            if (listPaymentMethod.Where(p => p.IsPayment == false).Any(p => p.PaymentMethodId == Invoice.PaymentMethodId))
                NavigationManager.NavigateTo("invoice-detail");

            if (listPaymentMethod.Where(p => p.IsPayment == true).Any(p => p.PaymentMethodId == Invoice.PaymentMethodId))
            {
                var isConfirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"⚠️ Change payment method to PENDING in order to add services, Are you sure ?");
                if (isConfirmed)
                {
                    await OnChangeInvoicePaymentStatusCallBack.InvokeAsync(false);
                    //ChangeInvoicePaymentMethodToPending(invoice);
                    NavigationManager.NavigateTo("invoice-detail");
                }
                return;
            }

        }
    }

