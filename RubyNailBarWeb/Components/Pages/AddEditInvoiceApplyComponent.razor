@page "/invoice/{id:int?}"
@* @page "/invoice-back-from/{id:int?}" *@

@rendermode InteractiveServer

@inject IInvoicesService InvoicesService
@inject IUsersService UsersService
@inject IStoresService StoresService
@inject ICustomersService CustomersService
@inject NavigationManager NavigationManager
@inject ContainerStorage ContainerStorage
@inject IPaymentMethodsService PaymentMethodsService
@inject IInvoiceDetailsService InvoiceDetailsService
@inject IJSRuntime JSRuntime


@if (Id.HasValue)
{
    <h3>Edit Invoice</h3>
}
else
{
    <h3>Add Invoice</h3>
}


<InvoiceComponent Invoice="@invoice" activeAddCustomerSection="@activeAddCustomerSection"
                                    OnChangeInvoicePaymentStatusCallBack="HandleChangeInvoicePayment"
                                    OnChangeInvoiceTotalBillCallBack="HandleUpdateInvoiceTotalBillChanged"
                                      CurrentPath="@currentPath" 
                                        AddCustomerSectionCallBack="HandleAddCustomerSectionCallBack"
                                        AddAdvancedSettingsSectionCallBack="HandleAddAdvancedSettingsSectionCallBack"
                                        InvoiceInfoChangedButNotSaveCallBack="HandleInvoiceChangeNotificationToUserCallBack"
                                        @ref="invoiceComponent">
</InvoiceComponent>

 @if(activeAddCustomerSection)
{
    <div class="ms-3">

        <AddCustomerFormComponent NewCustomerIdCallBack="HandleNewCustomerId" RemoveUserCallBack="HandleRemoveAddUserSection">
        </AddCustomerFormComponent>
       
    </div>
    <hr>
}



@if(this.invoice is not null)
{
    <InvoiceDetailComponent CurrentPath="@currentPath" Invoice="@invoice"
                            OnChangeInvoicePaymentStatusCallBack="HandleChangeInvoicePayment"
                            ActiveAddAdvacedSettingsSection="@activeAddAdvancedSettingsSection"
                            OnInvoiceDetailTimeChangedCallBack="HandleUpdateInvoiceDetailTimeChanged">
    </InvoiceDetailComponent>

}


@if (this.invoice is not null)
{
    <div class="ms-3 d-flex justify-content-between align-items-center mt-2">
        <div class="d-flex align-items-center">
            <button type="button" class="btn btn-primary" @onclick="async ()=> { await HandleBackButton();}">Back</button>
            <span class="ms-2 btn font-monospace  @(isPaymentCompleted == true ? "border-success text-success" : "border-light text-black text-opacity-50")"> $ @totalBill│ @totalTime min </span>
        </div>
        <div class="d-flex align-items-center">
            <button type="button" class="ms-2 btn btn-primary">Print</button>
            <button type="button" class="ms-2 btn btn-primary">Download</button>
            
        </div>
    </div>
}


@code {


    [Parameter]
    public int? Id { get; set; }

    private string currentPath = string.Empty;

    private bool activeAddCustomerSection = false;

    private bool activeAddAdvancedSettingsSection  =false;

    private Invoice? invoice { get; set; }

    private string? searchText { get; set; } = string.Empty;

    private Customer? selectedCustomerInfo = new Customer();

    private List<PaymentMethod> listPaymentMethod = new List<PaymentMethod>();

    private decimal totalBill = 0;

    private int totalTime = 0;

    private bool isPaymentCompleted = false;

    private bool IsInvoiceChangedButNotSave = false;

    private InvoiceComponent? invoiceComponent;

    private void HandleInvoiceChangeNotificationToUserCallBack(bool isChanged)
    {
        IsInvoiceChangedButNotSave = isChanged;
    }

    private int CalculateTotalInvoiceTime(Invoice invoice)
    {
        return ContainerStorage.CalculateTotalInvoiceTime(invoice);
    }

    private decimal CalculateInvoiceTotalBill(Invoice invoice)
    {
        return ContainerStorage.CalculateInvoiceTotalBill(invoice);
    }

    protected override void OnInitialized()
    {
        listPaymentMethod = PaymentMethodsService.GetPaymentMethodsService();
    }

    protected override void OnParametersSet()
    {
        if (this.Id.HasValue)
        {
            invoice ??= InvoicesService.GetInvoiceByIdService(this.Id.Value);

            if (invoice is not null)
            {
                // if (invoice.InvoiceDetails is not null && invoice.InvoiceDetails.Any()) 
                //     CalculateInvoiceServicesAmount(invoice);

                currentPath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri).Split('?', '#', '/')[0];

                ContainerStorage.SetSavePaginationPath(currentPath);

                //ContainerStorage.SetOptionalData(currentPath, "Invoice", invoice);


                ContainerStorage.SetOptionalData(currentPath, "ObjectId", invoice.InvoiceId);

                totalBill = CalculateInvoiceTotalBill(invoice);

                totalTime = CalculateTotalInvoiceTime(invoice);
            }


        }
        else
        {

            invoice ??= new Invoice()
            {
                InvoiceDate = DateOnly.FromDateTime(DateTime.Now),
                StoreId = 0,
                ServicesAmount = 0,
                GSTax = InvoicesService.GetGoodsAndServicesTaxValue(),
                PSTax = InvoicesService.GetProvincialSalesTaxValue(),
                Discount = InvoicesService.GetAppliedDiscount(),
                TipAmount = 0,
                CreatedDatetime = DateTime.Now,

            };

        }

    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            if (ContainerStorage.GetLastSelectedRecordId("invoices") == 0 && this.Id > 0)
            {
                // intercept
                NavigationManager.NavigateTo("/deny-access");

            }
        }
    }

    // private void CalculateInvoiceServicesAmount(Invoice? invoice)
    // {
    //     if(invoice is not null && invoice.InvoiceDetails is not null && invoice.InvoiceDetails.Any())
    //     {
    //         var originalInvoiceServicesAmount = invoice.ServicesAmount;
    //         var calculatedInvoiceServicesAmount = invoice.InvoiceDetails.Where(id => id.IsDeleted == false).Sum(id => id.ServiceFee);
    //         if (originalInvoiceServicesAmount == calculatedInvoiceServicesAmount) return;
    //         else if (calculatedInvoiceServicesAmount > 0 && originalInvoiceServicesAmount != calculatedInvoiceServicesAmount)
    //         {
    //             invoice.ServicesAmount = calculatedInvoiceServicesAmount;
    //             InvoicesService.UpdateInvoiceService(invoice.InvoiceId, invoice);
    //         }
    //     }
    // }

    private void HandleUpdateInvoiceTotalBillChanged()
    {
        if (invoice is not null)
        {
            totalBill = CalculateInvoiceTotalBill(invoice);
        }
    }

    private void HandleUpdateInvoiceDetailTimeChanged()
    {
        if (invoice is not null)
        {
            totalTime = CalculateTotalInvoiceTime(invoice);
        }
    }


    private void HandleChangeInvoicePayment(bool isPaymentCompleted)
    {
        if (invoice is not null)
        {
            if (this.isPaymentCompleted != isPaymentCompleted)
            {
                this.isPaymentCompleted = isPaymentCompleted;

            }

            if (!isPaymentCompleted)
            {
                bool? checkSelectedPaymentIsFinished = listPaymentMethod?.Where(p => p.IsPayment == true).Any(p => p.PaymentMethodId == invoice.PaymentMethodId);
                if (checkSelectedPaymentIsFinished == true)
                {
                    invoice.PaymentMethodId = listPaymentMethod?.Where(p => p.IsPayment == false).FirstOrDefault()?.PaymentMethodId;
                    invoice.ModifiedDatetime = DateTime.Now;
                    InvoicesService.UpdateInvoiceService(invoice.InvoiceId, invoice);
                    StateHasChanged();
                }
            }

        }
    }

    private void HandleAddAdvancedSettingsSectionCallBack(bool activeAddAdvancedSettingsSection)
    {
        if (this.activeAddAdvancedSettingsSection != activeAddAdvancedSettingsSection)
        {
            this.activeAddAdvancedSettingsSection = activeAddAdvancedSettingsSection;
        }
    }

    private void HandleAddCustomerSectionCallBack(bool activeAddCustomerSection)
    {
        if (this.activeAddCustomerSection != activeAddCustomerSection)
        {
            this.activeAddCustomerSection = activeAddCustomerSection;

        }
    }

    private void HandleInvoiceCallBack(Invoice invoice)
    {
        if(invoice is not null)
        {
            this.invoice = invoice;

        }

    }

    private void HandleRemoveAddUserSection()
    {
        activeAddCustomerSection = false;
    }

    private void HandleNewCustomerId(int newCustomerId)
    {
        if(invoice is not null && newCustomerId > 0 && invoice.CustomerId != newCustomerId)
        {
            invoice.CustomerId = newCustomerId;
            activeAddCustomerSection = false;
        }
    }


    private async Task HandleBackButton()
    {

        if (IsInvoiceChangedButNotSave)
        {
            var isConfirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"⚠️ Click OK to save the changed before leaving the page.");
            if (isConfirmed)
            {
                invoiceComponent?.HandleUpdateInvoiceButton();
            }

        }

        if (currentPath.Contains("back-from", StringComparison.OrdinalIgnoreCase))
        {
            var previousPath = ContainerStorage.GetSavePaginaionPath();
            NavigationManager.NavigateTo($"/{previousPath}");
            return;
        }

        NavigationManager.NavigateTo("/invoices");
        
    }

}
