@page "/invoice/{id:int?}"
@* @page "/invoice-back-from/{id:int?}" *@

@rendermode InteractiveServer

@inject IInvoicesService InvoicesService
@inject IUsersService UsersService
@inject IStoresService StoresService
@inject ICustomersService CustomersService
@inject NavigationManager NavigationManager
@inject ContainerStorage ContainerStorage
@inject IPaymentMethodsService PaymentMethodsService
@inject IInvoiceDetailsService InvoiceDetailsService
@inject IJSRuntime JSRuntime


@if (Id.HasValue)
{
    <h3>Edit Invoice</h3>
}
else
{
    <h3>Add Invoice</h3>
}

@if (invoice is not null)
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>
                    Store
                </th>
                <th>
                    Manager
                </th>
                <th>
                    Payment
                </th>
                <th>
                    Customer
                </th>
                <th>
                </th>
                <th>
                </th>
                <th>
                </th>
                <th>
                </th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>
                    <InputSelect class="form-select" TValue="int?"
                                 Value="invoice.StoreId"
                                 ValueChanged="@( (int? e) => {OnSelectStoreChanged(e);} )"
                                 ValueExpression="@(() => invoice.StoreId)">

                        <option value="0" disabled selected>-- Select Store --</option>
                        @if (listStores != null && listStores.Any())
                        {
                            @foreach(var store in listStores)
                            {
                                <option value="@store.StoreId" disabled="@Id.HasValue">@store.Name</option>

                            }

                        }
                    </InputSelect>
                </td>
                <td>

                        <InputSelect class="form-select" TValue="int?"
                                     Value="invoice.ManagerId"
                                     ValueChanged="@( (int? e) => {OnSelectManagerChanged(e);} )"
                                     ValueExpression="@(() => invoice.ManagerId)">

                        <option value="0" disabled selected>--Select Manager--</option>
                        @if (listManagers != null && listManagers.Any())
                        {
                            @foreach (var manager in listManagers)
                            {
                                <option value="@manager.UserId">@manager.FirstName @manager.LastName</option>

                            }

                        }
                    </InputSelect>
                </td>
                <td>
                        <InputSelect class="form-select" TValue="int?"
                                     Value="invoice.PaymentMethodId"
                                     ValueChanged="@(async (int? e) => {await OnSelectPaymentMethodChanged(e);} )"
                                     ValueExpression="@(() => invoice.PaymentMethodId)">

                        @if (!this.Id.HasValue && listPendingPayment != null && listPendingPayment.Any())
                        {

                            @foreach (var paymentMethod in listPendingPayment)
                            {
                                <option value="@paymentMethod.PaymentMethodId">@paymentMethod.Name</option>
                            }

                        }
                        else if (this.Id.HasValue && listPaymentMethod != null && listPaymentMethod.Any())
                        {
                            @foreach (var paymentMethod in listPaymentMethod)
                            {
                                <option value="@paymentMethod.PaymentMethodId">@paymentMethod.Name</option>
                            }
                        }
                    </InputSelect>
                </td>
                <td>
                    <input type="text" class="form-control" placeholder="Enter PhoneNo | Name" @bind="searchText" disabled="@Id.HasValue" />
                    @if (listFoundCustomers?.Any() == true)
                    {
                        <ul class="list-group position-absolute mt-1" style="z-index:1000; width:300px">

                            @foreach (var customer in listFoundCustomers)
                            {
                                <li class="list-group-item list-group-item-action" @onclick="() => HandleSelectCustomer(customer)"> @customer.Name - @customer.PhoneNo @($"{(customer.Birthday!=null? "- "+customer.Birthday?.ToString("MMM dd"): ""  )}")</li>
                            }
                        </ul>
                     }
                </td>

                @if (Id.HasValue)
                {
                    @if (isManagerChanged || isPaymentMethodChanged || isDescriptionChanged)
                    {
                        <td class="align-middle">
                            <button type="button" title="Update Invoice" class="bg-transparent border-2 border-light p-0" @onclick="HandleUpdateInvoiceButton">💾</button>
                        </td>
                        <td class="align-middle">
                            <button type="button" title="Advanced Settings" class="bg-transparent border-2 border-light p-0" @onclick="HandleAddAdvancedSettingsSection">🛠️</button>
                        </td>
                        <td class="align-middle" colspan="2">
                            <button type="button" title="Discard Update" class="bg-transparent border-2 border-light p-0" @onclick="HandleDiscardUpdateInvoiceButton">🚫</button>
                        </td>
                    }
                    else
                    {
                        <td class="align-middle">
                            <button type="button" title="Update Invoice" class="bg-transparent border-2 border-light p-0" @onclick="HandleUpdateInvoiceButton" disabled>💾</button>
                        </td>
                        <td class="align-middle">
                            <button type="button" title="Advanced Settings" class="bg-transparent border-2 border-light p-0" @onclick="HandleAddAdvancedSettingsSection">🛠️</button>
                        </td>
                        <td class="align-middle" colspan="2">
                            <button type="button" title="Add Services" class="bg-transparent border-2 border-light p-0" @onclick="HandleAddInvoiceDetailButton">➕</button>
                        </td>


                    }
                }
                else
                {
                    <td class="align-middle">
                        @if (invoice.CustomerId > 0)
                        {
                            <button type="button" title="Discard Customer" class="bg-transparent border-2 border-light p-0" @onclick="HandleClearCustomerSelectionButton" disabled="@Id.HasValue">❌</button>

                        }
                        else
                        {
                            <button type="button" title="Search Customer" class="bg-transparent border-2 border-light p-0" @onclick="HandleSearchButton">🔍</button>

                        }
                    </td>
                    <td class="align-middle">
                        @if (activeAddCustomerSection)
                        {
                            <button type="button" title="Dont Add Customer" class="bg-transparent border-2 border-light p-0" @onclick="HandleAddNewCustomerButton">🚫</button>

                        }
                        else
                        {
                            <button type="button" title="Add New Customer" class="bg-transparent border-2 border-light p-0" @onclick="HandleAddNewCustomerButton">👤</button>

                        }
                    </td>

                    <td class="align-middle">
                        <button type="button" title="Advanced Settings" class="bg-transparent border-2 border-light p-0" @onclick="HandleAddAdvancedSettingsSection">🛠️</button>
                    </td>

                    <td class="align-middle">
                        <button type="button" title="Add Invoice" class="bg-transparent border-2 border-light p-0" @onclick="HandleAddInvoiceButton" 
                                        disabled="@(invoice.CustomerId > 0 && invoice.StoreId > 0 && invoice.ManagerId > 0 ? false : true)">✔️</button>
                    </td>

                }



            </tr>
        </tbody>
    </table>

    // Advanced Settings
    @if (activeAddAdvacedSettingsSection)
    {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>
                        Total Services
                    </th>
                    <th>
                        Tip
                    </th>
                    <th>
                        GST
                    </th>
                    <th>
                        PST 
                    </th>
                    <th>
                        Description
                    </th>
                    <th>
                    </th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td class="align-middle">
                        <InputNumber class="form-control" @bind-Value="invoice.ServicesAmount" disabled="@(isPaymentCompleted)">

                        </InputNumber>
                    </td>
                    <td class="align-middle">

                        <InputNumber style="" class="form-control" @bind-Value="invoice.TipAmount" disabled="@(isPaymentCompleted)">

                        </InputNumber>
                    </td>
                    <td class="align-middle">
                        <div class="input-group input-group flex-nowrap">
                            <InputNumber TValue="decimal" class="form-control text-end"
                                         @bind-Value="this.goodServicesTax" step="0.1" min="0" max="100" disabled="@(isPaymentCompleted)" />
                            <span class="input-group-text">%</span>
                        </div>
                    </td>
                    <td class="align-middle input-group w-auto">
                        <div class="input-group input-group flex-nowrap">
                            <InputNumber TValue="decimal" class="form-control text-end"
                                         @bind-Value="this.provincialSalesTax" step="0.1" min="0" max="100" disabled="@(isPaymentCompleted)" />
                            <span class="input-group-text">%</span>
                        </div>
                    </td>
                    <td class="align-middle">
                        <InputText type="text" class="form-control" placeholder="Enter Description"
                                   Value="@invoice.Description"
                                   ValueChanged="@((string e) => { OnInvoiceDescriptionChange(e);} )"
                                   ValueExpression="@(() => invoice.Description)" />
                    </td>
                    <td class="align-middle">
                        <button type="button" title="Save to Watchlist" class="bg-transparent border-2 border-light p-0" @onclick="HandleMoveToWatchlist">
                            📒
                        </button>
                    </td>
                </tr>
            </tbody>
        </table>
    }
   


    <hr>

    @if(activeAddCustomerSection == true)
    {
        <div class="ms-3">

            <AddCustomerFormComponent NewCustomerIdCallBack="HandleNewCustomerId" RemoveUserCallBack="HandleRemoveAddUserSection">
            </AddCustomerFormComponent>
            <hr>
        </div>

    }

    //- -   -   -   -   -   -   Included Services activeAddAdvacedSettingsSection 48vh
    @if (Id.HasValue)
    {
        <div class="ms-3">
            <div>
                <span><i class="bi bi-person">Included Services</i></span>
            </div>

            <div class="table-responsive" style="overflow-y: auto; max-height: @(activeAddAdvacedSettingsSection==true?"35vh;":"48vh;")">
                <table class="table table-striped table-hover">
                    <thead class="bg-white">
                        <tr style="position:sticky; top:0; z-index:2;">
                            <th class="fw-normal">
                                <span> Id </span>   
                            </th>
                            <th class="fw-normal">
                                <span>Service</span>
                            </th>
                            <th class="fw-normal">
                                <span>Staff</span>
                            </th>
                            <th class="fw-normal">
                                <span>Fee</span>
                            </th>
                            <th class="fw-normal">
                                <span>Tip</span>
                            </th>
                            <th class="fw-normal">
                                <span>Minute</span>
                            </th>
                            <th class="fw-normal">
                                <span>Status</span>
                            </th>
                            <th>
                            </th>
                            <th>
                            </th>
                            <th>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (invoice.InvoiceDetails != null && invoice.InvoiceDetails.Any() 
                                    && listInvoiceDetails is not null && listInvoiceDetails.Any())
                    {

                        @foreach (var invoiceDetail in listInvoiceDetails)
                        {
                                <tr class="align-middle" style="background-color:@(invoiceDetail.InvoiceDetailId == selectedInvoiceDetailId ? "#d8dbf2" : "white")">
                                <td style="cursor:pointer">
                                    @invoiceDetail.InvoiceDetailId
                                </td>
                                <td style="cursor:pointer">
                                    @invoiceDetail.CustomerService?.Name
                                </td>
                                <td style="cursor:pointer">

                                        <button type="button" class="btn btn-link p-0 text-decoration-none text-primary text-start" @onclick="()=>{HandleNavigateToSelectedStaff(invoiceDetail);}"> @invoiceDetail.User?.FirstName @invoiceDetail.User?.LastName </button>
                                </td>
                                <td style="cursor:pointer">
                                    @if (invoiceDetail.ServiceFee != null && invoiceDetail.ServiceFee > 0)
                                    {
                                        @invoiceDetail.ServiceFee
                                    }
                                    else
                                    {
                                        <span>····</span>
                                    }
                                </td>
                                <td style="cursor:pointer">
                                        @if (invoiceDetail.Tip != null && invoiceDetail.Tip.Value > 0.01m)
                                    {
                                        @invoiceDetail.Tip
                                    }
                                    else
                                    {
                                        <span>····</span>
                                    }
                                </td>
                                <td style="cursor:pointer">
                                    @if ( invoiceDetail is not null && (invoiceDetail?.EndDatetime - invoiceDetail?.StartDatetime)?.TotalMinutes > 0)
                                    {
                                            //(int)Math.Ceiling((double)
                                            var tempTime = (invoiceDetail?.EndDatetime - invoiceDetail?.StartDatetime)?.TotalMinutes;
                                            @((int)Math.Ceiling((double)(tempTime??0)))
                                    }
                                    else
                                    {
                                        <span>····</span>
                                    }
                                </td>
                                <td style="cursor:pointer">
                                        <span class=@($"badge border {(CheckInvoieDetailStatus(invoiceDetail).status == "Completed" ? "border-success text-success" : (CheckInvoieDetailStatus(invoiceDetail).status == "Running" ? "border-danger text-danger" : "border-secondary text-secondary"))}")>
                                                                            @CheckInvoieDetailStatus(invoiceDetail).status</span>
                                </td>
                                <td class="align-middle">

                                        <button type="button" title="Switch Status" class="bg-transparent border-2 border-light p-0" @onclick="async () => { await HandleChangeInvoiceDetailStatusButton(invoiceDetail); }"> @CheckInvoieDetailStatus(invoiceDetail).emoji </button>
                                             
                                </td>
                                <td class ="align-middle">
                                        <button type="button" class="bg-transparent border-2 border-light p-0" @onclick="() => { HandleEditInvoiceDetailButton(invoiceDetail); }">✏️</button>
                                </td>
                                    <td class="align-middle">
                                        <button type="button" class="bg-transparent border-2 border-light p-0" @onclick=" async()=>{ await HandleDeleteInvoiceDetailButton(invoiceDetail);}">❌</button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td class="text-center text-black-50" colspan="10">
                                No Data
                            </td>
                        </tr>
                    }

                    </tbody>

                </table>
            </div>
        </div>


    }
    
    <button type="button" class="btn btn-primary mt-2" @onclick="HandleBackButton">Back</button>

    @if (this.Id.HasValue)
    {

        <button type="button" class="ms-2 btn btn-primary mt-2">Print Invoice</button>

        <button type="button" class="ms-2 btn btn-primary mt-2">Download Invoice</button>
    }


}



@code {

    [Parameter]
    public string? Path { get; set; }

    [Parameter]
    public int? Id { get; set; }

    private decimal provincialSalesTax = 0;

    private decimal goodServicesTax = 0;

    private string currentPath = string.Empty;

    private int selectedInvoiceId;

    private int selectedInvoiceDetailId;

    private bool activeAddCustomerSection = false;

    private bool activeAddAdvacedSettingsSection = false;

    private Invoice? invoice { get; set; }

    private List<InvoiceDetail>? listInvoiceDetails = new List<InvoiceDetail>();

    private List<User> listManagers = new List<User>();

    private List<Store>? listStores = new List<Store>();

    private List<PaymentMethod>? listPaymentMethod = new List<PaymentMethod>();

    private List<PaymentMethod>? listPendingPayment = new List<PaymentMethod>();

    private string? searchText { get; set; } = string.Empty;

    private Customer? selectedCustomerInfo = new Customer();

    private List<Customer>? listFoundCustomers = new List<Customer>();

    private int? snapshotPaymentMethodId;

    private int? snapshotManagerId;

    private string? snapshotDescription;

    private bool isPaymentMethodChanged = false;

    private bool isManagerChanged = false;

    private bool isDescriptionChanged = false;

    private bool isFirstRender = true;

    private bool isPaymentCompleted = false;

    private void HandleAddAdvancedSettingsSection()
    {
        activeAddAdvacedSettingsSection = !activeAddAdvacedSettingsSection;
    } 


    private void HandleMoveToWatchlist()
    {
        if(invoice is not null)
        {
            invoice.IsImportant = true;
        }
    }

    private void OnInvoiceDescriptionChange(string changedValue)
    {
        if (invoice is not null)
        {
            invoice.Description = changedValue;
            isDescriptionChanged = true;
        }
    }

    private void HandleNavigateToSelectedStaff(InvoiceDetail invoiceDetail)
    {
        if (invoiceDetail is not null && invoiceDetail.User is not null)
        {

            selectedInvoiceDetailId = invoiceDetail.InvoiceDetailId;
            ContainerStorage.SetSelectedRecordId(currentPath, invoiceDetail.InvoiceDetailId);

            NavigationManager.NavigateTo($"/user-back-from/{invoiceDetail.User?.UserId}");
        }

    }

    private async Task HandleDeleteInvoiceDetailButton(InvoiceDetail? invoiceDetail)
    {
        if (invoice is not null && invoiceDetail is not null && !invoiceDetail.IsDeleted && listInvoiceDetails is not null)
        {


            selectedInvoiceDetailId = 0;
            ContainerStorage.SetSelectedRecordId(currentPath, 0);

            invoiceDetail.IsDeleted = true;
            InvoiceDetailsService.UpdateInvoiceDetailService(invoiceDetail.InvoiceDetailId, invoiceDetail);
            // remove item from the list
            //listInvoiceDetails.Remove(invoiceDetail);

            // re-load listInvoiceDetails
            listInvoiceDetails = invoice.InvoiceDetails.Where(id => !id.IsDeleted)
                                                        .OrderBy(id => CheckInvoieDetailStatus(id).rank)
                                                        .ThenByDescending(id => id.ModifiedDatetime)
                                                         .ToList();

            if (!listInvoiceDetails.Any())
            {
                var isConfirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"ℹ️ Click OK to reset the time and change payment method to PENDING, Are you sure ?");
                if (isConfirmed)
                {
                    ChangeInvoicePaymentMethodToPending(invoice);
                }
            }
        }
    }

    private void HandleUpdateStartTime(InvoiceDetail invoiceDetail)
    {
        if (invoiceDetail is not null)
        {
            if (invoiceDetail.StartDatetime is null)
            {
                invoiceDetail.StartDatetime = DateTime.Now;
                if (invoiceDetail.EndDatetime is not null)
                {
                    invoiceDetail.EndDatetime = null;
                }
            }
            else
            {
                invoiceDetail.StartDatetime = null;
                if (invoiceDetail.EndDatetime is not null)
                {
                    invoiceDetail.EndDatetime = null;
                    invoiceDetail.IsFinished = false;
                }
            }
            InvoiceDetailsService.UpdateInvoiceDetailService(invoiceDetail.InvoiceDetailId, invoiceDetail);

        }
    }

    private void HandleUpdateEndTime(InvoiceDetail invoiceDetail)
    {
        if (invoiceDetail is not null && invoiceDetail.StartDatetime is not null)
        {
            if (invoiceDetail.EndDatetime is null)
            {
                if (invoiceDetail.StartDatetime.HasValue)
                {
                    invoiceDetail.EndDatetime = DateTime.Now;
                    invoiceDetail.IsFinished = true;
                }
            }
            else
            {
                invoiceDetail.EndDatetime = null;
                invoiceDetail.IsFinished = false;
            }
            InvoiceDetailsService.UpdateInvoiceDetailService(invoiceDetail.InvoiceDetailId, invoiceDetail);
        }
    }

    private async Task HandleChangeInvoiceDetailStatusButton(InvoiceDetail? invoiceDetail)
    {
        if (invoice is not null && invoiceDetail is not null)
        {
            selectedInvoiceDetailId = invoiceDetail.InvoiceDetailId;
            ContainerStorage.SetSelectedRecordId(currentPath, invoiceDetail.InvoiceDetailId);

            if (invoiceDetail.StartDatetime is null && invoiceDetail.EndDatetime is null)
            {
                HandleUpdateStartTime(invoiceDetail);
            }
            else if ((invoiceDetail.StartDatetime is not null) && (invoiceDetail.EndDatetime is null))
            {
                HandleUpdateEndTime(invoiceDetail);
            }
            else if (invoiceDetail.StartDatetime is not null && invoiceDetail.EndDatetime is not null)
            {
                var isConfirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"ℹ️ Click OK to reset the time and change payment method to PENDING, Are you sure ?");
                if (isConfirmed)
                {
                    // bool? checkSelectedPaymentIsFinished = listPaymentMethod?.Where(p => p.IsPayment == true).Any(p => p.PaymentMethodId == invoice.PaymentMethodId);
                    // if (checkSelectedPaymentIsFinished == true)
                    // {
                    //     invoice.PaymentMethodId = listPaymentMethod?.Where(p => p.IsPayment == false).FirstOrDefault()?.PaymentMethodId;
                    // }
                    ChangeInvoicePaymentMethodToPending(invoice);
                    HandleUpdateStartTime(invoiceDetail);   
                }

            }
        }
    }

    private (string status,string emoji, int rank) CheckInvoieDetailStatus(InvoiceDetail? invoiceDetail)
    {
        return ContainerStorage.CheckInvoieDetailStatus(invoiceDetail);

    }

    private async Task OnSelectPaymentMethodChanged(int? valueChanged)
    {
        if (valueChanged is not null && valueChanged.Value > 0 && valueChanged != invoice?.PaymentMethodId && invoice is not null)
        {
            if (listPaymentMethod is not null && listPaymentMethod.Where(p => p.IsPayment == true).Any(p => p.PaymentMethodId == valueChanged.Value))
            {
                if (!this.Id.HasValue || this.Id is null)
                {
                    await JSRuntime.InvokeVoidAsync("confirm", $"⚠️ Payment cannot process due to no services.");
                    ChangeInvoicePaymentMethodToPending(invoice);
                    return;
                }
                else if (invoice.InvoiceDetails.All(id => id.IsDeleted == true))
                {
                    await JSRuntime.InvokeVoidAsync("confirm", $"⚠️ Payment cannot process due to no services.");
                    ChangeInvoicePaymentMethodToPending(invoice);
                    return;
                }
                else if (invoice.InvoiceDetails.Any()
                                        && invoice.InvoiceDetails.Any(id => id.IsDeleted == false 
                                                                        && !ContainerStorage.CheckInvoieDetailStatus(id).status.Equals("Completed", StringComparison.OrdinalIgnoreCase)))
                {
                    await JSRuntime.InvokeVoidAsync("confirm", $"⚠️ All Services must be in COMPLETED status prior to payment process.");
                    ChangeInvoicePaymentMethodToPending(invoice);
                    return;
                }
                // Payment => Completed 
                if (invoice.InvoiceDetails.Any() 
                                        && invoice.InvoiceDetails.All(id => id.IsDeleted == false 
                                                                                    && ContainerStorage.CheckInvoieDetailStatus(id).status.Equals("Completed", StringComparison.OrdinalIgnoreCase)))
                {
                    invoice.PaymentMethodId = valueChanged.Value;
                    isPaymentCompleted = true;
                    isPaymentMethodChanged = true;
                    return;
                }
            }
            // Payment => Pending 
            if (listPaymentMethod is not null && listPaymentMethod.Where(p => p.IsPayment == false).Any(p => p.PaymentMethodId == valueChanged.Value))
            {
                invoice.PaymentMethodId = valueChanged.Value;
                isPaymentCompleted = false;
                isPaymentMethodChanged = true;
            }


        }
    }

    private void ChangeInvoicePaymentMethodToPending(Invoice invoice)
    {
        if(invoice is not null)
        {
            bool? checkSelectedPaymentIsFinished = listPaymentMethod?.Where(p => p.IsPayment == true).Any(p => p.PaymentMethodId == invoice.PaymentMethodId);
            if (checkSelectedPaymentIsFinished == true)
            {
                invoice.PaymentMethodId = listPaymentMethod?.Where(p => p.IsPayment == false).FirstOrDefault()?.PaymentMethodId;
                snapshotPaymentMethodId = invoice.PaymentMethodId;
                InvoicesService.UpdateInvoiceService(invoice.InvoiceId, invoice);
                isPaymentCompleted = false;
            }
        }
    }

    private void OnSelectManagerChanged(int? valueChanged)
    {
        if (valueChanged is not null && valueChanged.Value > 0 && valueChanged != invoice?.ManagerId && invoice is not null)
        {
            invoice.ManagerId = valueChanged.Value;
            isManagerChanged = true;
        }
    }

    private void HandleDiscardUpdateInvoiceButton()
    {

        if(invoice is not null)
        {
            if (snapshotManagerId > 0)
            {
                invoice.ManagerId = snapshotManagerId;
            }
            if (snapshotPaymentMethodId > 0)
            {
                invoice.PaymentMethodId = snapshotPaymentMethodId;
            }

            invoice.Description = snapshotDescription??String.Empty;
            
            isManagerChanged = false;
            isPaymentMethodChanged = false;
            isDescriptionChanged = false;
        }

    }

    private void HandleUpdateInvoiceButton()
    {
        if(invoice is not null)
        {
            InvoicesService.UpdateInvoiceService(invoice.InvoiceId, invoice);
            isManagerChanged = false;
            isPaymentMethodChanged = false;
            isDescriptionChanged = false;
        }
    }

    private async Task HandleAddInvoiceDetailButton()
    {
        if (listPaymentMethod is not null && invoice is not null)
        {
            if (listPaymentMethod.Where(p => p.IsPayment==false).Any(p => p.PaymentMethodId == invoice.PaymentMethodId))
                NavigationManager.NavigateTo("invoice-detail");

            if (listPaymentMethod.Where(p => p.IsPayment == true).Any(p => p.PaymentMethodId == invoice.PaymentMethodId))
            {
                var isConfirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"⚠️ Change payment method to PENDING in order to add services, Are you sure ?");
                if (isConfirmed)
                {
                    ChangeInvoicePaymentMethodToPending(invoice);
                    NavigationManager.NavigateTo("invoice-detail");
                }
                return;
            }

        }
    }

    private void HandleEditInvoiceDetailButton(InvoiceDetail? invoiceDetail)
    {
        if (invoiceDetail is not null)
        {
            //Container Storage
            selectedInvoiceDetailId = invoiceDetail.InvoiceDetailId;

            ContainerStorage.SetSelectedRecordId(currentPath, invoiceDetail.InvoiceDetailId);

            ContainerStorage.SetOptionalData(currentPath, "InvoiceDetail", invoiceDetail);

            NavigationManager.NavigateTo($"/invoice-detail/{invoiceDetail.InvoiceDetailId}");
        }
    }

    private void HandleBackButton()
    {
        if (currentPath.Contains("back-from", StringComparison.OrdinalIgnoreCase))
        {
            var previousPath = ContainerStorage.GetSavePaginaionPath();
            NavigationManager.NavigateTo($"/{previousPath}");
        }
        else
        {
            NavigationManager.NavigateTo("/invoices");
        }
    }

    private void HandleAddInvoiceButton()
    {
        if( invoice is not null && invoice.CustomerId > 0 && invoice.StoreId > 0 && invoice.ManagerId > 0)
        {
            int newInvoiceId = InvoicesService.AddInvoiceService(invoice);

            ContainerStorage.ResetPaginationData(currentPath);
            ContainerStorage.SetSelectedRecordId("invoices", newInvoiceId);

            NavigationManager.NavigateTo($"/invoice/{newInvoiceId}");
        }
    }

    private void HandleRemoveAddUserSection()
    {
        activeAddCustomerSection = false;
    }

    private void HandleNewCustomerId(int newCustomerId)
    {
        if(invoice is not null && newCustomerId > 0)
        {

            selectedCustomerInfo = CustomersService.GetCustomerByIdService(newCustomerId);

            if(selectedCustomerInfo is not null)
            {
                invoice.CustomerId = selectedCustomerInfo.CustomerId;
                searchText = $"{selectedCustomerInfo?.Name} - {selectedCustomerInfo?.PhoneNo}";
                activeAddCustomerSection = false;
            }

        }
    }

    private void HandleAddNewCustomerButton()
    {
        activeAddCustomerSection = !activeAddCustomerSection;
    }

    private void HandleSearchButton()
    {
        if (string.IsNullOrWhiteSpace(searchText)) 
        { 
            listFoundCustomers?.Clear();
        }
        else
        {
            listFoundCustomers = CustomersService.SearchCustomerService(searchText);
        }
    }

    private void HandleClearCustomerSelectionButton()
    {
        if (invoice?.CustomerId !=null && invoice?.CustomerId > 0)
        {
            searchText = string.Empty;
            invoice.CustomerId = 0;
            listFoundCustomers?.Clear();
        }
    }

    private void HandleSelectCustomer(Customer customer)
    { 
        if (customer is not null && invoice is not null)
        {
            searchText = $"{customer.Name} - {customer.PhoneNo}";

            invoice.CustomerId = customer.CustomerId;
            listFoundCustomers?.Clear();
        }

    }


    private void OnSelectStoreChanged(int? valueChanged)
    {
        if (valueChanged is not null && valueChanged.Value > 0 && valueChanged != invoice?.StoreId && invoice is not null)
        {
            invoice.StoreId = valueChanged.Value;
            invoice.ManagerId = 0;
            listManagers = UsersService.GetManagerListByStoreIdService(valueChanged.Value);

        }

    }

    protected override void OnAfterRender(bool firstRender)
    {
        if(firstRender && this.Id.HasValue)
        {

            selectedInvoiceId = ContainerStorage.GetLastSelectedRecordId("invoices");

            if ( selectedInvoiceId == 0 && this.Id.Value != selectedInvoiceId)
                NavigationManager.NavigateTo("/deny-access");

            //this.selectedInvoiceDetailId = ContainerStorage.GetLastSelectedRecordId(currentPath);

        }
    }



    protected override void OnParametersSet()
    {
        listPaymentMethod = PaymentMethodsService.GetPaymentMethodsService();


        if (this.Id.HasValue)
        {
            invoice ??= InvoicesService.GetInvoiceByIdService(this.Id.Value);

            if (invoice is not null)
            {
                if (invoice.CustomerId > 0)
                {
                    selectedCustomerInfo = CustomersService.GetCustomerByIdService(invoice.CustomerId.Value);

                    searchText = $"{selectedCustomerInfo?.Name} - {selectedCustomerInfo?.PhoneNo}";
                }
                if (invoice.StoreId >0)
                {
                    listManagers = UsersService.GetManagerListByStoreIdService(invoice.StoreId.Value);
                }

                if(invoice.InvoiceDetails is not null)
                {
                    listInvoiceDetails = invoice.InvoiceDetails.Where(id => !id.IsDeleted)
                                                                .OrderBy(id => CheckInvoieDetailStatus(id).rank)
                                                                .ThenByDescending(id => id.ModifiedDatetime)
                                                                 .ToList();
                }

                snapshotPaymentMethodId = invoice.PaymentMethodId;

                snapshotManagerId = invoice.ManagerId;

                snapshotDescription = invoice.Description??String.Empty;

                currentPath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri).Split('?', '#','/')[0];

                ContainerStorage.SetSavePaginationPath(currentPath);

                ContainerStorage.SetOptionalData(currentPath, "Invoice", invoice);

                ContainerStorage.SetOptionalData(currentPath, "ObjectId", invoice.InvoiceId);

                this.selectedInvoiceDetailId = ContainerStorage.GetLastSelectedRecordId(currentPath);


            }


        }
        else
        {
            listPendingPayment = listPaymentMethod?.Where(p => p.IsPayment == false).ToList();
            invoice ??= new Invoice() 
            { 
                InvoiceDate = DateOnly.FromDateTime(DateTime.Now),
                StoreId = 0,
                ServicesAmount = 0,
                TaxAmount = 0,
                TipAmount = 0,
                CreatedDatetime = DateTime.Now,
                PaymentMethodId = listPendingPayment?.FirstOrDefault()?.PaymentMethodId
            };

        }
        
        if (isFirstRender)
        {
            listStores = StoresService.GetActiveStoresService();
            this.provincialSalesTax = InvoicesService.GetProvincialSalesTaxValue();
            this.goodServicesTax = InvoicesService.GetGoodsAndServicesTaxValue();
        }
        isFirstRender = false;

    }



}
