@page "/invoice/{id:int?}"
@* @page "/invoice-back-from/{id:int?}" *@

@inject IInvoicesService InvoicesService
@inject IUsersService UsersService
@inject IStoresService StoresService
@inject ICustomersService CustomersService
@inject NavigationManager NavigationManager
@inject ContainerStorage ContainerStorage
@inject IPaymentMethodsService PaymentMethodsService
@rendermode InteractiveServer



@if (Id.HasValue)
{
    <h3>Edit Invoice</h3>
}
else
{
    <h3>Add Invoice</h3>
}

@if (invoice is not null)
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>
                    Store
                </th>
                <th>
                    Manager
                </th>
                <th>
                    Payment
                </th>
                <th>
                    Customer
                </th>
                <th>
                </th>
                <th>
                </th>
                <th>
                </th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>
                    <InputSelect class="form-select" TValue="int?"
                                 Value="invoice.StoreId"
                                 ValueChanged="@( (int? e) => {OnSelectStoreChanged(e);} )"
                                 ValueExpression="@(() => invoice.StoreId)">

                        <option value="0" disabled selected>-- Select Store --</option>
                        @if (listStores != null && listStores.Any())
                        {
                            @foreach(var store in listStores)
                            {
                                <option value="@store.StoreId" disabled="@Id.HasValue">@store.Name</option>

                            }

                        }
                    </InputSelect>
                </td>
                <td>

                        <InputSelect class="form-select" TValue="int?"
                                     Value="invoice.ManagerId"
                                     ValueChanged="@( (int? e) => {OnSelectManagerChanged(e);} )"
                                     ValueExpression="@(() => invoice.ManagerId)">

                        <option value="0" disabled selected>--Select Manager--</option>
                        @if (listManagers != null && listManagers.Any())
                        {
                            @foreach (var manager in listManagers)
                            {
                                <option value="@manager.UserId">@manager.FirstName @manager.LastName</option>

                            }

                        }
                    </InputSelect>
                </td>
                <td>
                        <InputSelect class="form-select" TValue="int?"
                                     Value="invoice.PaymentMethodId"
                                     ValueChanged="@( (int? e) => {OnSelectPaymentMethodChanged(e);} )"
                                     ValueExpression="@(() => invoice.PaymentMethodId)">

                        @if (listPaymentMethod != null && listPaymentMethod.Any())
                        {
                            @foreach (var paymentMethod in listPaymentMethod)
                            {
                                <option value="@paymentMethod.PaymentMethodId">@paymentMethod.Name</option>
                            }

                        }
                    </InputSelect>
                </td>
                <td>
                    <input type="text" class="form-control" placeholder="Enter PhoneNo | Name" @bind="searchText" disabled="@Id.HasValue" />
                    @if (listFoundCustomers?.Any() == true)
                    {
                        <ul class="list-group position-absolute mt-1" style="z-index:1000; width:300px">

                            @foreach (var customer in listFoundCustomers)
                            {
                                <li class="list-group-item list-group-item-action" @onclick="() => HandleSelectCustomer(customer)"> @customer.Name - @customer.PhoneNo @($"{(customer.Birthday!=null? "- "+customer.Birthday?.ToString("MMM dd"): ""  )}")</li>
                            }
                        </ul>
                     }
                </td>

                @if (Id.HasValue)
                {
                    @if (isManagerChanged || isPaymentMethodChanged)
                    {
                        <td colspan="2" class="align-middle">
                            <button type="button" title="Update Invoice" class="btn btn-outline-secondary" @onclick="HandleUpdateInvoiceButton">💾</button>
                        </td>
                        <td class="align-middle">
                            <button type="button" title="Discard Update" class="bg-transparent border-2 border-light p-0" @onclick="HandleDiscardUpdateInvoiceButton">🚫</button>
                        </td>
                    }
                    else
                    {
                        <td colspan="2" class="align-middle">
                            <button type="button" title="Update Invoice" class="bg-transparent border-2 border-light p-0" @onclick="HandleUpdateInvoiceButton" disabled>💾</button>
                        </td>
                        <td class="align-middle">
                            <button type="button" title="Add Services" class="bg-transparent border-2 border-light p-0" @onclick="HandleAddInvoiceDetailButton">➕</button>
                        </td>
                    }
                }
                else
                {
                    <td class="align-middle">
                        @if (invoice.CustomerId > 0)
                        {
                            <button type="button" title="Discard Customer" class="bg-transparent border-2 border-light p-0" @onclick="HandleClearCustomerSelectionButton" disabled="@Id.HasValue">❌</button>

                        }
                        else
                        {
                            <button type="button" title="Search Customer" class="bg-transparent border-2 border-light p-0" @onclick="HandleSearchButton">🔍</button>

                        }
                    </td>
                    <td class="align-middle">
                        @if (activeAddCustomerSection)
                        {
                            <button type="button" title="Dont Add Customer" class="bg-transparent border-2 border-light p-0" @onclick="HandleAddNewCustomerButton">🚫</button>

                        }
                        else
                        {
                            <button type="button" title="Add New Customer" class="bg-transparent border-2 border-light p-0" @onclick="HandleAddNewCustomerButton">👤</button>

                        }
                    </td>
                    <td class="align-middle">
                        <button type="button" title="Add Invoice" class="bg-transparent border-2 border-light p-0" @onclick="HandleAddInvoiceButton" disabled="@(invoice.CustomerId > 0 && invoice.StoreId > 0 && invoice.ManagerId > 0 ? false : true)">✔️</button>
                    </td>
                }


            </tr>
        </tbody>
    </table>
    <hr>

    @if(activeAddCustomerSection == true)
    {
        <div class="ms-3">

            <AddCustomerFormComponent NewCustomerIdCallBack="HandleNewCustomerId" RemoveUserCallBack="HandleRemoveAddUserSection">
            </AddCustomerFormComponent>
            <hr>
        </div>

    }


    @if (Id.HasValue)
    {
        <div class="ms-3">
            <div>
                <span><i class="bi bi-person">Included Services</i></span>
            </div>

            <div class="table-responsive" style=" max-height: 48vh; overflow-y: auto;">
                <table class="table table-striped table-hover">
                    <thead class="table-light">
                        <tr style="position:sticky; top:0; z-index:2;">
                            <th>
                                <span> Id </span>
                            </th>
                            <th>
                                <span>Service</span>
                            </th>
                            <th>
                                <span>Staff</span>
                            </th>
                            <th>
                                <span>Fee</span>
                            </th>
                            <th>
                                <span>Tip</span>
                            </th>
                            <th>
                                <span>Minute</span>
                            </th>
                            <th>
                                <span>Status</span>
                            </th>
                            <th>
                            </th>
                            <th>
                            </th>
                            <th>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                    @if (invoice.InvoiceDetails != null && invoice.InvoiceDetails.Any())
                    {

                        @foreach (var invoiceDetail in invoice.InvoiceDetails.OrderBy(id => id.IsFinished).OrderByDescending(id => id.InvoiceDetailId))
                        {
                            <tr class="align-middle">
                                <td style="cursor:pointer">
                                    @invoiceDetail.InvoiceDetailId
                                </td>
                                <td style="cursor:pointer">
                                    @invoiceDetail.CustomerService?.Name
                                </td>
                                <td style="cursor:pointer">
                                    <a href=@($"/user-back-from/{invoiceDetail.User?.UserId}")>
                                        @invoiceDetail.User?.FirstName @invoiceDetail.User?.LastName
                                    </a>
                                </td>
                                <td style="cursor:pointer">
                                    @if (invoiceDetail.ServiceFee != null)
                                    {
                                        @invoiceDetail.ServiceFee
                                    }
                                    else
                                    {
                                        <span class="fst-italic">- -</span>
                                    }
                                </td>
                                <td style="cursor:pointer">
                                    @if (invoiceDetail.Tip != null)
                                    {
                                        @invoiceDetail.Tip
                                    }
                                    else
                                    {
                                        <span class="fst-italic">- -</span>
                                    }
                                </td>
                                <td style="cursor:pointer">
                                    @if ((invoiceDetail?.EndDatetime - invoiceDetail?.StartDatetime)?.TotalMinutes >= 0)
                                    {
                                        @((invoiceDetail?.EndDatetime - invoiceDetail?.StartDatetime)?.TotalMinutes)
                                    }
                                    else
                                    {
                                        <span class="fst-italic">- -</span>
                                    }
                                </td>
                                <td style="cursor:pointer">
                                    <span class=@($"badge border {(invoiceDetail?.IsFinished == true ? "border-success text-success" : "border-danger text-danger")}")>@(invoiceDetail?.IsFinished == true ? "Finished" : "Not Yet")</span>
                                </td>
                                <td class="align-middle">
                                    @if (invoiceDetail?.IsFinished == false)
                                    {
                                            <button type="button" class="bg-transparent border-2 border-light p-0">🚩</button>
                                    }
                                    else
                                    {
                                            <button type="button" class="bg-transparent border-2 border-light p-0">♻️</button>

                                    }
                                </td>
                                <td class ="align-middle">
                                        <button type="button" class="bg-transparent border-2 border-light p-0" @onclick="() => { HandleEditInvoiceDetailButton(invoiceDetail); }">✏️</button>
                                </td>
                                    <td class="align-middle">
                                        <button type="button" class="bg-transparent border-2 border-light p-0">❌</button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td class="text-center text-black-50" colspan="9">
                                No Data
                            </td>
                        </tr>
                    }

                    </tbody>

                </table>
            </div>
        </div>
    }
    
    <button type="button" class="btn btn-primary mt-2" @onclick="HandleBackButton">Back</button>

}



@code {

    [Parameter]
    public string? Path { get; set; }

    [Parameter]
    public int? Id { get; set; }

    private string currentPath = string.Empty;

    private int selectedInvoiceId;

    private bool activeAddCustomerSection = false;

    private Invoice? invoice { get; set; }

    private List<User> listManagers = new List<User>();

    private List<Store>? listStores = new List<Store>();

    private List<PaymentMethod>? listPaymentMethod = new List<PaymentMethod>();

    private string? searchText { get; set; } = string.Empty;

    private Customer? selectedCustomerInfo = new Customer();

    private List<Customer>? listFoundCustomers = new List<Customer>();

    private int? snapshotPaymentMethodId;

    private int? snapshotManagerId;

    private bool isPaymentMethodChanged = false;

    private bool isManagerChanged = false; 

    private void OnSelectPaymentMethodChanged(int? valueChanged)
    {
        if (valueChanged is not null && valueChanged.Value > 0 && valueChanged != invoice?.PaymentMethodId && invoice is not null)
        {
            invoice.PaymentMethodId = valueChanged.Value;
            isPaymentMethodChanged = true;
        }
    }

    private void OnSelectManagerChanged(int? valueChanged)
    {
        if (valueChanged is not null && valueChanged.Value > 0 && valueChanged != invoice?.ManagerId && invoice is not null)
        {
            invoice.ManagerId = valueChanged.Value;
            isManagerChanged = true;
        }
    }

    private void HandleDiscardUpdateInvoiceButton()
    {

        if(invoice is not null)
        {
            if (snapshotManagerId > 0)
            {
                invoice.ManagerId = snapshotManagerId;
            }
            invoice.PaymentMethodId = snapshotPaymentMethodId ?? 1;
            isManagerChanged = false;
            isPaymentMethodChanged = false;
        }

    }

    private void HandleUpdateInvoiceButton()
    {
        if(invoice is not null)
        {
            InvoicesService.UpdateInvoiceService(invoice.InvoiceId, invoice);
            isManagerChanged = false;
            isPaymentMethodChanged = false;
        }
    }

    private void HandleAddInvoiceDetailButton()
    {
        NavigationManager.NavigateTo("invoice-detail");
    }

    private void HandleEditInvoiceDetailButton(InvoiceDetail? invoiceDetail)
    {
        if (invoiceDetail is not null)
        {
            //Container Storage

            ContainerStorage.SetSelectedRecordId(currentPath, invoiceDetail.InvoiceDetailId);

            ContainerStorage.SetOptionalData(currentPath, "InvoiceDetail", invoiceDetail);

            NavigationManager.NavigateTo($"/invoice-detail/{invoiceDetail.InvoiceDetailId}");
        }
    }

    private void HandleBackButton()
    {
        if (currentPath.Contains("back-from", StringComparison.OrdinalIgnoreCase))
        {
            var previousPath = ContainerStorage.GetSavePaginaionPath();
            NavigationManager.NavigateTo($"/{previousPath}");
        }
        else
        {
            NavigationManager.NavigateTo("/invoices");
        }
    }

    private void HandleAddInvoiceButton()
    {
        if( invoice is not null && invoice.CustomerId > 0 && invoice.StoreId > 0 && invoice.ManagerId > 0)
        {
            int newInvoiceId = InvoicesService.AddInvoiceService(invoice);

            ContainerStorage.ResetPaginationData(currentPath);
            ContainerStorage.SetSelectedRecordId("invoices", newInvoiceId);

            NavigationManager.NavigateTo($"/invoice/{newInvoiceId}");
        }
    }

    private void HandleRemoveAddUserSection()
    {
        activeAddCustomerSection = false;
    }

    private void HandleNewCustomerId(int newCustomerId)
    {
        if(invoice is not null && newCustomerId > 0)
        {

            selectedCustomerInfo = CustomersService.GetCustomerByIdService(newCustomerId);
            if(selectedCustomerInfo is not null)
            {
                invoice.CustomerId = selectedCustomerInfo.CustomerId;
                searchText = $"{selectedCustomerInfo?.Name} - {selectedCustomerInfo?.PhoneNo}";
                activeAddCustomerSection = false;
            }

        }
    }

    private void HandleAddNewCustomerButton()
    {
        activeAddCustomerSection = !activeAddCustomerSection;
    }

    private void HandleSearchButton()
    {
        if (string.IsNullOrWhiteSpace(searchText)) 
        { 
            listFoundCustomers?.Clear();
        }
        else
        {
            listFoundCustomers = CustomersService.SearchCustomerService(searchText);
        }
    }

    private void HandleClearCustomerSelectionButton()
    {
        if (invoice?.CustomerId !=null && invoice?.CustomerId > 0)
        {
            searchText = string.Empty;
            invoice.CustomerId = 0;
            listFoundCustomers?.Clear();
        }
    }

    private void HandleSelectCustomer(Customer customer)
    { 
        if (customer is not null && invoice is not null)
        {
            searchText = $"{customer.Name} - {customer.PhoneNo}";

            invoice.CustomerId = customer.CustomerId;
            listFoundCustomers?.Clear();
        }

    }


    private void OnSelectStoreChanged(int? valueChanged)
    {
        if (valueChanged is not null && valueChanged.Value > 0 && valueChanged != invoice?.StoreId && invoice is not null)
        {
            invoice.StoreId = valueChanged.Value;
            invoice.ManagerId = 0;
            listManagers = UsersService.GetManagerListByStoreIdService(valueChanged.Value);

        }

    }

    protected override void OnAfterRender(bool firstRender)
    {
        if(firstRender && this.Id.HasValue)
        {
            selectedInvoiceId = ContainerStorage.GetLastSelectedRecordId("invoices");

            if ( selectedInvoiceId == 0 && this.Id.Value != selectedInvoiceId)
                NavigationManager.NavigateTo("/deny-access");


        }
    }

    protected override void OnParametersSet()
    {
        if (this.Id.HasValue)
        {
            invoice ??= InvoicesService.GetInvoiceByIdService(this.Id.Value);
            if (invoice is not null)
            {
                if (invoice.CustomerId > 0)
                {
                    selectedCustomerInfo = CustomersService.GetCustomerByIdService(invoice.CustomerId.Value);

                    searchText = $"{selectedCustomerInfo?.Name} - {selectedCustomerInfo?.PhoneNo}";
                }
                if (invoice.StoreId >0)
                {
                    listManagers = UsersService.GetManagerListByStoreIdService(invoice.StoreId.Value);
                }
                
                snapshotPaymentMethodId = invoice.PaymentMethodId;

                snapshotManagerId = invoice.ManagerId;

                currentPath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri).Split('?', '#','/')[0];

                ContainerStorage.SetSavePaginationPath(currentPath);

                ContainerStorage.SetOptionalData(currentPath, "Invoice", invoice);

                ContainerStorage.SetOptionalData(currentPath, "ObjectId", invoice.InvoiceId);
            }
            
        }
        else
        {
            invoice ??= new Invoice() 
            { 
                InvoiceDate = DateOnly.FromDateTime(DateTime.Now),
                StoreId = 0,
                ServicesAmount = 0,
                TaxAmount = 0,
                TipAmount = 0,
                CreatedDatetime = DateTime.Now,
                PaymentMethodId = 1
            };

        }

        listStores = StoresService.GetActiveStoresService();
        listPaymentMethod = PaymentMethodsService.GetPaymentMethodsService();

    }



}
