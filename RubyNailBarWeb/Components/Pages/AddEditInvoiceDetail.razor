@page "/invoice-detail/{id:int?}"

@rendermode InteractiveServer
@inject IInvoiceDetailsService InvoiceDetailsService
@inject ContainerStorage ContainerStorage
@inject IInvoicesService InvoicesService
@inject NavigationManager NavigationManager


@if (this.Id.HasValue)
{
    <h3>Edit Invoice Detail</h3>
}
else
{
    <h3>Add New Invoice Detail </h3>
}

@if (invoiceDetail is not null)
{
    <EditForm Model="invoiceDetail" FormName="invoiceDetailForm" OnValidSubmit="SubmitFunc">
        <DataAnnotationsValidator></DataAnnotationsValidator>
        <div class="container">
            <form class="form-horizontal">
                <div class="row">
                    <div class="col-sm-12 col-sm-offset-1">
                        <div class="row row-centered">

                            <div class="col-xs-4 col-sm-4 col-centered">
                                @if (invoice is not null)
                                {
                                    <HorizonListComponent Label="Invoice Id">
                                        <Control>
                                            <InputNumber @bind-Value="invoice.InvoiceId" disabled></InputNumber>
                                        </Control>
                                    </HorizonListComponent>

                                    <HorizonListComponent Label="Invoice Date">
                                        <Control>
                                            <input type="datetime" value=@(invoice.InvoiceDate?.ToString("yyyy-MM-dd")) disabled>
                                        </Control>
                                    </HorizonListComponent>
                                    @if (invoice.PaymentMethod is not null)
                                    {
                                        <HorizonListComponent Label="Payment">
                                            <Control>
                                                <InputText @bind-Value="invoice.PaymentMethod.Name" disabled="true"></InputText>
                                            </Control>
                                        </HorizonListComponent>
                                    }
                                }
                            </div>

                            <div class="col-xs-4 col-sm-4 col-centered">
                                @if (invoice is not null && invoice.Store is not null && invoice.Manager is not null && invoice.Customer is not null)
                                {
                                    <HorizonListComponent Label="Store">
                                        <Control>
                                            <InputText @bind-Value="invoice.Store.Name" disabled="true"></InputText>
                                        </Control>
                                    </HorizonListComponent>

                                    <HorizonListComponent Label="Manager">
                                        <Control>
                                            <input type="text" value=@($"{invoice.Manager.FirstName} {invoice.Manager.LastName}") disabled>
                                        </Control>
                                    </HorizonListComponent>

                                    <HorizonListComponent Label="Customer">
                                        <Control>
                                            <input type="text" value=@($"{invoice.Customer.Name}") disabled>
                                        </Control>
                                    </HorizonListComponent>
                                }
                            </div>

                            <div class="col-xs-4 col-sm-4 col-centered">
                                @if (invoice is not null && invoice.Store is not null && invoice.Manager is not null && invoice.Customer is not null)
                                {
                                    <HorizonListComponent Label="Store">
                                        <Control>
                                            <InputNumber @bind-Value="invoice.ServicesAmount" disabled="true"></InputNumber>
                                        </Control>
                                    </HorizonListComponent>

                                    <HorizonListComponent Label="Manager">
                                        <Control>
                                            <InputNumber @bind-Value="invoice.TipAmount" disabled="true"></InputNumber>
                                        </Control>
                                    </HorizonListComponent>

                                    <HorizonListComponent Label="Customer">
                                        <Control>
                                            <InputNumber @bind-Value="invoice.TaxAmount" disabled="true"></InputNumber>
                                        </Control>
                                    </HorizonListComponent>
                                }
                            </div>

  
                            
                        </div>
                        <hr>
                        <div class="row row-centered">
                            <div class="col-xs-12 col-sm-6 col-centered">

                                <HorizonListComponent Label="InvoiceDetail Id">
                                    <Control>
                                        <InputNumber @bind-Value="invoiceDetail.InvoiceDetailId" disabled></InputNumber>
                                    </Control>
                                </HorizonListComponent>

                                <FieldComponent Label="Service Type">
                                    <Control>
                                        <InputSelect class="form-select" ValueExpression="@(() => selectedCustomerService.ServiceType)"
                                                     Value="@selectedCustomerService.ServiceType"
                                                     ValueChanged="(string e) => { OnServiceTypeChanged(e); }">

                                            <option value="" disabled selected>-- Select Services --</option>
                                            @foreach (var service in listCustomerServices)
                                            {
                                                <option value="@service.ServiceType">@service.ServiceType</option>
                                            }
                                        </InputSelect>
                                    </Control>
                                </FieldComponent>

                                <FieldComponent Label="Service Name">
                                    <Control>
@*                                         <InputNumber @bind-Value="invoiceDetail.CustomerService.Name"></InputNumber>
 *@                                 </Control>
                                </FieldComponent>

                            </div>

                            <div class="col-xs-12 col-sm-6 col-centered">

                                <FieldComponent Label="Staff">
                                    <Control>
                                        <InputSelect @bind-Value="invoiceDetail.UserId">
                                            
                                        </InputSelect>
                                    </Control>
                                </FieldComponent>
                                <FieldComponent Label="Service Fee">
                                    <Control>
                                        <InputNumber @bind-Value="invoiceDetail.ServiceFee"></InputNumber>
                                    </Control>
                                </FieldComponent>

                                <FieldComponent Label="Tip Fee">
                                    <Control>
                                        <InputNumber @bind-Value="invoiceDetail.Tip"></InputNumber>
                                    </Control>
                                </FieldComponent>

                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </div>

        <button class="btn btn-primary" type="button" @onclick="() => HandleBackButton()">Back</button>
        &nbsp;
        <button class="btn btn-primary" type="submit"> @(Id.HasValue == true ? "Update" : "Add") </button>

    </EditForm>
}



@code {
    [Parameter]
    public int? Id { get; set; }

    [SupplyParameterFromForm]
    public InvoiceDetail? invoiceDetail { get; set; }

    private List<User>? listUsers { get; set; }

    private Invoice? invoice;

    private CustomerService selectedCustomerService { get; set; } = new CustomerService();

    private string selectedCustomerServicesType { get; set; } = string.Empty;

    private List<CustomerService> listCustomerServices = new List<CustomerService>();

    private string currentPath = string.Empty;

    protected override void OnParametersSet()
    {
        if (this.Id.HasValue)
        {
            invoiceDetail = InvoiceDetailsService.GetValidInvoiceDetailByIdService(this.Id.Value);
        }
        else
        {
            invoiceDetail = new InvoiceDetail();
        }
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if(firstRender)
        {

            if (ContainerStorage.CheckElementOptionalDataExist("invoice", "Invoice"))
            {
                invoice = ContainerStorage.GetElementOptionalData<Invoice>("invoice", "Invoice") ?? new Invoice();
            }

            if (ContainerStorage.CheckElementOptionalDataExist("invoice", "InvoiceDetail"))
            {
                invoiceDetail = ContainerStorage.GetElementOptionalData<InvoiceDetail>("invoice", "InvoiceDetail") ?? new InvoiceDetail();
            }



            StateHasChanged();
        }
    }

    private void OnServiceTypeChanged(string e)
    {
        selectedCustomerService.ServiceType = e?.ToString();
        //listCustomerServices = 
        
    }


    private void HandleBackButton()
    {
        if (currentPath.Contains("back-from", StringComparison.OrdinalIgnoreCase))
        {
            var previousPath = ContainerStorage.GetSavePaginaionPath();
            NavigationManager.NavigateTo($"/{previousPath}");
        }
        else
        {
            NavigationManager.NavigateTo("/invoices");
        }
    }

    private void SubmitFunc()
    {
        
    }




}
