@page "/invoice-detail/{id:int?}"

@rendermode InteractiveServer
@inject IInvoiceDetailsService InvoiceDetailsService
@inject ContainerStorage ContainerStorage
@inject IInvoicesService InvoicesService
@inject NavigationManager NavigationManager
@inject ICustomerServicesService CustomerServicesService
@inject IUsersService UsersService
@inject IInvoicesService InvoicesService
@inject IPaymentMethodsService PaymentMethodsService
@inject IJSRuntime JSRuntime

@if (invoiceDetail is not null)
{
   
   @*  <div class="container"> *@
        <form @onsubmit="SubmitFunc">

            <!-- ===== Invoice Information ===== -->
            <fieldset class="mb-3">
                @* <legend class="h3 mb-3">Invoice Information:</legend> *@
               <div class="d-inline-flex align-items-center gap-3">
                    <span class="h3 mb-0">Invoice Information</span>
                    <button type="button" class="ps-1 pe-1 bg-transparent border-2 border-light p-0 text-black shadow-sm" @onclick="HandleShowInvoiceInfoSection"> @emojiInvoiceInfo</button>
                    <br/>
                    <br/>
                </div>
                @if (showInvoiceInfoSection)
                {
                    @if (!showSecondPageInvoiceInfoSection)
                    {
                    <div class="row g-4">
                        <!-- Col 1 -->
                        <div class="col-12 col-lg-4">
                            @if (invoice is not null)
                            {
                                <HorizonListComponent Label="Invoice Id">
                                    <Control>
                                        <InputNumber @bind-Value="invoice.InvoiceId" class="form-control" disabled />
                                    </Control>
                                </HorizonListComponent>

                                <HorizonListComponent Label="Created At">
                                    <Control>
                                        <input type="datetime" value=@(invoice.CreatedDatetime?.ToString("yyyy-MM-dd HH:mm:ss")) class="form-control" disabled>
                                    </Control>
                                </HorizonListComponent>

                                @if (invoice.PaymentMethod is not null)
                                {
                                    <HorizonListComponent Label="Payment">
                                        <Control>
                                            <InputText class="form-control" @bind-Value="invoice.PaymentMethod.Name" disabled />
                                        </Control>
                                    </HorizonListComponent>
                                }
                            }
                        </div>

                        <!-- Col 2 -->
                        <div class="col-12 col-lg-4">
                            @if (invoice is not null && invoice.Store is not null && invoice.Manager is not null && invoice.Customer is not null)
                            {
                                <HorizonListComponent Label="Store">
                                    <Control>
                                        <InputText class="form-control" @bind-Value="invoice.Store.Name" disabled />
                                    </Control>
                                </HorizonListComponent>


                                <HorizonListComponent Label="Manager">
                                    <Control>
                                        <input type="text" class="form-control" value=@($"{invoice.Manager.FirstName} {invoice.Manager.LastName}") disabled>
                                    </Control>
                                </HorizonListComponent>


                                <HorizonListComponent Label="Customer">
                                    <Control>
                                        <input type="text" class="form-control" value=@($"{invoice.Customer.Name}") disabled>
                                    </Control>
                                </HorizonListComponent>
                            }
                        </div>

                        <!-- Col 3 (Totals) -->
                        <div class="col-12 col-lg-4">
                            @if (invoice is not null)
                            {
                                <HorizonListComponent Label="All Services">
                                    <Control>
                                        <InputNumber @bind-Value="invoice!.ServicesAmount" class="form-control" disabled />
                                    </Control>
                                </HorizonListComponent>

                                <HorizonListComponent Label="💵 Tip">
                                    <Control>
                                        <InputNumber @bind-Value="invoice!.TipAmount" class="form-control" disabled />
                                    </Control>
                                </HorizonListComponent>

                                <HorizonListComponent Label="">
                                    <Control>
                                        @*  <InputNumber @bind-Value="invoice!.TaxAmount" class="form-control" disabled /> *@
                                        <button type="button" class="btn btn-secondary" @onclick="HandleInvoiceMoreInfoButton">More</button>
                                    </Control>
                                </HorizonListComponent>
                            }
                        </div>
                    </div>
                    }
                    else
                    {
                    <div class="row g-4">
                        <!-- Col 1 -->
                        <div class="col-12 col-lg-4">
                            @if (invoice is not null)
                            {
                                <HorizonListComponent Label="GSTax">
                                    <Control>
                                        <InputNumber @bind-Value="invoice.GSTax" class="form-control" disabled />
                                    </Control>
                                </HorizonListComponent>

                                <HorizonListComponent Label="PSTax">
                                    <Control>
                                        <InputNumber @bind-Value="invoice.PSTax" class="form-control" disabled />
                                    </Control>
                                </HorizonListComponent>

                                @if (invoice.PaymentMethod is not null)
                                {
                                    <HorizonListComponent Label="Payment 2">
                                        <Control>
                                            <InputText class="form-control" @bind-Value="invoice.PaymentMethod.Name" disabled />
                                        </Control>
                                    </HorizonListComponent>
                                }
                            }
                        </div>

                        <!-- Col 2 -->
                        <div class="col-12 col-lg-4">
                            @if (invoice is not null && invoice.Store is not null && invoice.Manager is not null && invoice.Customer is not null)
                            {
                                <HorizonListComponent Label="Store 2">
                                    <Control>
                                        <InputText class="form-control" @bind-Value="invoice.Store.Name" disabled />
                                    </Control>
                                </HorizonListComponent>


                                <HorizonListComponent Label="Manager 2">
                                    <Control>
                                        <input type="text" class="form-control" value=@($"{invoice.Manager.FirstName} {invoice.Manager.LastName}") disabled>
                                    </Control>
                                </HorizonListComponent>


                                <HorizonListComponent Label="Customer 2">
                                    <Control>
                                        <input type="text" class="form-control" value=@($"{invoice.Customer.Name}") disabled>
                                    </Control>
                                </HorizonListComponent>
                            }
                        </div>

                        <!-- Col 3 (Totals) -->
                        <div class="col-12 col-lg-4">
                            @if (invoice is not null)
                            {
                                <HorizonListComponent Label="All Services">
                                    <Control>
                                        <InputNumber @bind-Value="invoice!.ServicesAmount" class="form-control" disabled />
                                    </Control>
                                </HorizonListComponent>

                                <HorizonListComponent Label="💵 Tip">
                                    <Control>
                                        <InputNumber @bind-Value="invoice!.TipAmount" class="form-control" disabled />
                                    </Control>
                                </HorizonListComponent>

                                <HorizonListComponent Label="">
                                    <Control>
                                        @*  <InputNumber @bind-Value="invoice!.TaxAmount" class="form-control" disabled /> *@
                                        <button type="button" class="btn btn-secondary" @onclick="HandleInvoiceMoreInfoButton">More</button>
                                    </Control>
                                </HorizonListComponent>
                            }
                        </div>
                    </div>
                    }
                }

            </fieldset>

            <hr />

            <!-- ===== Invoice Detail (edit) ===== -->
            <fieldset class="mb-3">
                @if (this.Id.HasValue)
                {
                    <p class="h4 p-1">Edit Service</p>
                }
                else
                {
                    <p class="h4 p-1">Add Service</p>
                }
                <div class="row g-4">
                    <!-- Col 1: what service -->
                    <div class="col-12 col-lg-5">
                        @if(invoice is not null && invoice.Store is not null)
                        {
                            <HorizonListComponent Label="Store">
                                <Control>
                                    <InputText class="form-control" @bind-Value="invoice.Store.Name" disabled />
                                </Control>
                            </HorizonListComponent>
                        }

                        <HorizonListComponent Label="Service Type">
                            <Control>
                                <InputSelect class="form-select" ValueExpression="@(() => selectedServiceTypes)"
                                             Value="@selectedServiceTypes"
                                             ValueChanged="(string e) => { OnServiceTypeChanged(e); }">
                                    <option value="" disabled>- Select Type -</option>
                                    @foreach (var serviceType in listCustomerServiceTypes)
                                    {
                                        <option value="@serviceType">@serviceType</option>
                                    }
                                </InputSelect>
                            </Control>
                        </HorizonListComponent>
                        
                        <HorizonListComponent Label="Service Name">
                            <Control>
                                <InputSelect class="form-select" TValue="int?" ValueExpression="@(() => invoiceDetail.CustomerServiceId)"
                                             Value="@invoiceDetail.CustomerServiceId"
                                             ValueChanged="(int? e) => { OnCustomerServiceChanged(e); }">
                                    <option value="0" disabled>- Select Service -</option>
                                    @foreach (var service in listCustomerServices)
                                    {
                                        <option value="@service.CustomerServiceId">@service.Name</option>
                                    }
                                </InputSelect>
                            </Control>
                        </HorizonListComponent>

                        <HorizonListComponent Label="Staff">
                            <ElementControl>
                                <button type="button" style="margin-left: 1.5rem" title="Go to User Page"
                                        class="bg-transparent border-2 border-light p-0 " @onclick="HandleNavigateToUserInStore">@emojiSearchUser
                                </button>
                            </ElementControl>
                            <Control>
                                <InputSelect class="form-select" @bind-Value="invoiceDetail.UserId">
                                    <option value="0" disabled>- Select Staff -</option>
@*                                 @foreach (var staff in listStaffsByStoreId)
                                    {
                                        <option value="@staff.UserId" disabled="@(!staff.IsActive || staff.IsDeleted)"
                                            class="@(staff.IsDeleted ? "text-muted text-opacity-75" : (staff.IsActive ? "text-success" : "text-danger"))"> @(staff.IsDeleted ? "❌" : (staff.IsActive ? "🔔 " : "🔕 "))  @staff.FirstName @staff.LastName┃@staff.Username </option>
                                    } *@

                                <optgroup label="Active">
                                    @foreach (var staff in listStaffsByStoreId.Where(s => s.IsActive && !s.IsDeleted))
                                    {
                                        <option value="@staff.UserId" class="text-success">
                                            🔔 @staff.FirstName @staff.LastName ┃ @staff.Username
                                        </option>
                                    }
                                </optgroup>

                                <optgroup label="Inactive">
                                    @foreach (var staff in listStaffsByStoreId.Where(s => !s.IsActive && !s.IsDeleted))
                                    {
                                        <option value="@staff.UserId" class="text-danger" disabled>
                                            🔕  @staff.FirstName @staff.LastName ┃ @staff.Username
                                        </option>
                                    }
                                </optgroup>

                                <optgroup label="Deleted">
                                    @foreach (var staff in listStaffsByStoreId.Where(s => s.IsDeleted))
                                    {
                                        <option value="@staff.UserId" class="text-muted" disabled>
                                            ❌ @staff.FirstName @staff.LastName ┃ @staff.Username
                                        </option>
                                    }
                                </optgroup>

                                </InputSelect>
                                
                            </Control>
                        </HorizonListComponent>

                    </div>

                    <!-- Col 2: who + fees -->
                  
                    <div class="col-12 col-lg-3">
                       
                        <HorizonListComponent Label="Id">
                            <Control>
                                <InputNumber @bind-Value="invoiceDetail.InvoiceDetailId" class="form-control" disabled></InputNumber>
                            </Control>
                        </HorizonListComponent>

                        <HorizonListComponent Label="Finished">
                            <Control>
                                <InputCheckbox TValue="bool" ValueExpression="@(() => invoiceDetail.IsFinished)"
                                               Value="@invoiceDetail.IsFinished"
                                               ValueChanged="(bool e) => {OnIsFinishedCheckBoxChanged(e); }" 
                                               disabled="@(!invoiceDetail.StartDatetime.HasValue)"></InputCheckbox>
                            </Control>
                        </HorizonListComponent>

                        <HorizonListComponent Label="Delete">
                            <Control>
                                <InputCheckbox @bind-Value="invoiceDetail.IsDeleted"></InputCheckbox>
                            </Control>
                        </HorizonListComponent>
                    </div>
                    <!-- Col 3: optional 2nd staff (remove if not needed) -->

                    <div class="col-12 col-lg-4">

                        <HorizonListComponent Label="Started">
                            <ElementControl>
                                <button type="button" class="bg-transparent border-2 border-light p-0" @onclick="async ()=> {await HandleUpdateStartTime();}">@GetEmojiStartTime()</button>
                            </ElementControl>
                            <Control>
                                <input type="datetime" value="@invoiceDetail.StartDatetime?.ToString("yyyy-MM-dd HH:mm:ss")" class="form-control">
                            </Control>
                        </HorizonListComponent>

                        <HorizonListComponent Label="Ended󠀠󠀠󠀠️">
                            <ElementControl>
                                <button type="button" style="margin-left: 0.2rem" class=" bg-transparent border-2 border-light p-0" 
                                                        @onclick="HandleUpdateEndTime" disabled="@(!invoiceDetail.StartDatetime.HasValue)">@GetEmojiEndTime()</button>
                            </ElementControl>
                            <Control>
                                <input type="datetime" value="@invoiceDetail.EndDatetime?.ToString("yyyy-MM-dd HH:mm:ss")" class="form-control">
                            </Control>
                        </HorizonListComponent>

                        <HorizonListComponent Label="Fee">
                            <Control>
                                <InputNumber @bind-Value="invoiceDetail.ServiceFee" class="form-control" step="1"></InputNumber>
                            </Control>
                        </HorizonListComponent>

                        <HorizonListComponent Label="Tip">
                            <Control>
                                <InputNumber @bind-Value="invoiceDetail.Tip" class="form-control" step="0.5"></InputNumber>
                            </Control>
                        </HorizonListComponent>


@* 
                        <HorizonListComponent Label="⏰ Created">
                            <Control>
                                <input type="datetime" value="@invoiceDetail.CreatedDatetime?.ToString("yyyy-MM-dd HH:mm:ss")" class="form-control" disabled>
                            </Control>
                        </HorizonListComponent>

                        <HorizonListComponent Label="🛠️ Modified">
                            <Control>
                                <input type="datetime" value="@invoiceDetail.ModifiedDatetime?.ToString("yyyy-MM-dd HH:mm:ss")" class="form-control" disabled>
                            </Control>
                        </HorizonListComponent> *@

                    </div>

                </div>
            </fieldset>

            <div class="d-flex justify-content-sm-start mt-4">
                <button class="btn btn-primary" type="button" @onclick="() => HandleBackButton()">Back</button>
                &nbsp;
                <button class="btn btn-primary" type="submit"> @(Id.HasValue == true ? "Update" : "Add") </button>
            </div>

        </form>
    @* </div> *@
}


@* show model *@





@code {
    [Parameter]
    public int? Id { get; set; }

    private List<User> listStaffsByStoreId { get; set; } = new List<User>();

    private InvoiceDetail? invoiceDetail { get; set; }

    private List<String> listCustomerServiceTypes = new List<String>();

    private string? selectedServiceTypes = string.Empty;

    private List<CustomerService> listCustomerServices = new List<CustomerService>();

    private List<PaymentMethod> listPaymentMethod = new List<PaymentMethod>();

    private List<User>? listUsers { get; set; }

    private int invoiceId; 

    private Invoice? invoice;

    private string currentPath = string.Empty;

    private bool showInvoiceInfoSection = false;

    private bool showSecondPageInvoiceInfoSection = false;

    private string emojiInvoiceInfo = "☰";

    private const string emojiSearchUser = "🔎";

    private void HandleInvoiceMoreInfoButton()
    {
        if(invoice is not null)
        {
            showSecondPageInvoiceInfoSection = !showSecondPageInvoiceInfoSection;
        }
    }

    private RenderFragment GetEmojiStartTime() => builder =>
    {
        string icon = "";

        if (invoiceDetail is not null)
        {
            if (invoiceDetail.StartDatetime is null)
                icon = "🚩";
            else icon = "❌";
        }

        builder.AddContent(0, icon);
    };


    private RenderFragment GetEmojiEndTime() => builder =>
     {
         string icon = "";

         if (invoiceDetail is not null)
         {
             if (invoiceDetail.EndDatetime is null)
                 icon = "🏁";
             else icon = "❌";
         }

         builder.AddContent(0, icon);
     };


    private void OnIsFinishedCheckBoxChanged(bool changedValue)
    {
        if(invoiceDetail is not null)
        {
            invoiceDetail.IsFinished = changedValue;
            if(invoiceDetail.IsFinished)
            {
                invoiceDetail.EndDatetime = DateTime.Now;
            }
            else
            {
                invoiceDetail.EndDatetime = null;
            }
        }
    }

    private void OnCustomerServiceChanged(int? changedValue)
    {
        if (invoiceDetail is not null && changedValue > 0)
        {
            invoiceDetail.CustomerServiceId = changedValue;
            var selectedCustomerService = listCustomerServices.FirstOrDefault(cs => cs.CustomerServiceId == changedValue);
            if (selectedCustomerService is not null)
            {
                invoiceDetail.ServiceFee = selectedCustomerService.Fee;
                invoiceDetail.Tip = 0;
            }
        }
    }

    private void ChangeInvoicePaymentMethodToPending(Invoice invoice)
    {
        if (invoice is not null && invoice.PaymentMethod is not null)
        {
            bool? checkSelectedPaymentIsFinished = listPaymentMethod?.Where(p => p.IsPayment == true).Any(p => p.PaymentMethodId == invoice.PaymentMethodId);
            if (checkSelectedPaymentIsFinished == true)
            {
                invoice.PaymentMethod = listPaymentMethod?.Where(p => p.IsPayment == false).FirstOrDefault();
                invoice.PaymentMethodId = listPaymentMethod?.Where(p => p.IsPayment == false).FirstOrDefault()?.PaymentMethodId;
                InvoicesService.UpdateInvoiceService(invoice.InvoiceId, invoice);
            }
        }
    }


    private async Task HandleUpdateStartTime()
    {
        if(invoice is not null && invoiceDetail is not null )
        {
            if(invoiceDetail.StartDatetime is null)
            {
                invoiceDetail.StartDatetime = DateTime.Now;
                if (invoiceDetail.EndDatetime is not null)
                {
                    invoiceDetail.EndDatetime = null;
                }

            }
            else
            {
                var isConfirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"ℹ️ Click OK to reset the time and change payment method to PENDING, Are you sure ?");
                if (isConfirmed)
                {
                    invoiceDetail.StartDatetime = null;
                    if (invoiceDetail.EndDatetime is not null)
                    {
                        invoiceDetail.EndDatetime = null;
                        invoiceDetail.IsFinished = false;
                    }
                    ChangeInvoicePaymentMethodToPending(invoice);

                }
            }
        }
    }

    private void HandleUpdateEndTime()
    {
        if (invoiceDetail is not null && invoiceDetail.StartDatetime is not null)
        {
            if(invoiceDetail.EndDatetime is null)
            {
                if (invoiceDetail.StartDatetime.HasValue)
                {
                    invoiceDetail.EndDatetime = DateTime.Now;
                    invoiceDetail.IsFinished = true;

                }

            }
            else
            {
                invoiceDetail.EndDatetime = null;
                invoiceDetail.IsFinished = false;

            }

        }
    }

    private async Task HandleNavigateToUserInStore()
    {
        if(invoice is not null && invoice.StoreId > 0)
        {
            ContainerStorage.SetOptionalData("users", "SelectedStoreId", invoice.StoreId);
            if (invoiceDetail is not null && invoiceDetail.UserId > 0)
            {
                int pageSize = 5;
                (int currentPage, int totalPage) paginationTuple;

                paginationTuple = UsersService.GetCurrentPageAndTotalPageService(pageSize, invoiceDetail.UserId.Value, invoice.StoreId);

                if (paginationTuple.currentPage != 0 && paginationTuple.totalPage != 0)
                {
                    ContainerStorage.SetCurrentPage("users", paginationTuple.currentPage);

                    ContainerStorage.SetTotalPages("users", paginationTuple.totalPage);

                    ContainerStorage.SetSelectedRecordId("users", invoiceDetail.UserId.Value);

                    NavigationManager.NavigateTo($"/users");

                    return;
                }
                else
                {
                    var isConfirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"⚠️ Staff Id {invoiceDetail.UserId.Value} is DELETED, Click OK to edit this user ?");
                    if (isConfirmed)
                    {
                        NavigationManager.NavigateTo($"/user/{invoiceDetail.UserId.Value}");
                    }
                }

            }

           
        }
    }

    private void HandleShowInvoiceInfoSection()
    {
        showInvoiceInfoSection = !showInvoiceInfoSection;
        if (!showInvoiceInfoSection) emojiInvoiceInfo = "☰";
        else
        {
            emojiInvoiceInfo = "▼";
        }
    }


    protected override void OnInitialized()
    {
        listCustomerServiceTypes = CustomerServicesService.GetCustomerServiceTypeService();

        listPaymentMethod = PaymentMethodsService.GetPaymentMethodsService();

        if (ContainerStorage.CheckElementOptionalDataExist("invoice", "ObjectId"))
        {
            invoiceId = ContainerStorage.GetElementOptionalData<int>("invoice", "ObjectId");
            invoice = InvoicesService.GetInvoiceByIdService(invoiceId);
        }

        if (invoice is not null && invoice.StoreId > 0)
        {
            listStaffsByStoreId = UsersService.GetStaffListByStoreIdService(invoice.StoreId.Value).OrderBy(u => !u.IsActive).ToList();
        }
    }


    protected override void OnParametersSet()
    {
        if (this.Id.HasValue)
        {
            invoiceDetail = InvoiceDetailsService.GetValidInvoiceDetailByIdService(this.Id.Value);

            if (invoiceDetail is not null && invoiceDetail.CustomerServiceId.HasValue)
            {
                var customerService = CustomerServicesService.GetCustomerServiceByIdService(invoiceDetail.CustomerServiceId.Value);

                if (customerService is not null && !string.IsNullOrEmpty(customerService.ServiceType))
                {
                    listCustomerServices = CustomerServicesService.GetCustomerServiceByTypeService(customerService.ServiceType) ?? new();

                    selectedServiceTypes = customerService.ServiceType;
                }
            }
        }
        else
        {
            invoiceDetail = new InvoiceDetail() {CustomerServiceId = 0, UserId = 0};
        }

    }

    protected override void OnAfterRender(bool firstRender)
    {
        if(firstRender)
        {

            if (ContainerStorage.GetLastSelectedRecordId("invoice") == 0 && this.Id > 0)
            {
                // intercept
                NavigationManager.NavigateTo("/deny-access");
                
            }
            //StateHasChanged();
        }
    }

    private void OnServiceTypeChanged(string e)
    {
        selectedServiceTypes = e?.ToString();
        if (invoiceDetail is not null)
        {
            invoiceDetail.CustomerServiceId = 0;

        }
        if (!string.IsNullOrEmpty(selectedServiceTypes))
        {
            listCustomerServices = CustomerServicesService.GetCustomerServiceByTypeService(selectedServiceTypes) ?? new();
        }
    }


    private void HandleBackButton()
    {

        var previousPath = ContainerStorage.GetSavePaginaionPath();
        if (!String.IsNullOrEmpty(previousPath))
        {
            NavigationManager.NavigateTo($"/{previousPath}");
        }
        else
        {
            NavigationManager.NavigateTo("/invoices");
        }

    }

    private async Task SubmitFunc()
    {
        // Validate data in form before submit 
        if (invoice is null || invoiceDetail is null)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"⛔ No Information About Invoice and Service, please back to Invoices page ❗");
            NavigationManager.NavigateTo("/invoices");
        }
        if (invoiceDetail?.CustomerServiceId is null || invoiceDetail?.UserId is null ||
                        invoiceDetail?.CustomerServiceId <= 0 || invoiceDetail?.UserId <= 0)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"ℹ️ Please select Service Type, Service Name and Staff ❗");
            return;
        }
        if (invoiceDetail is not null && invoiceDetail.StartDatetime.HasValue && invoiceDetail.EndDatetime.HasValue 
                                        && invoiceDetail.StartDatetime >  invoiceDetail.EndDatetime)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"⛔ Start time cannot be later than end time ❗");
            return;
        }
        // 
        if (invoice is not null && invoiceDetail is not null 
                && invoiceDetail.CustomerServiceId > 0 && invoiceDetail.UserId  > 0)
        {

            invoiceDetail.ModifiedDatetime = DateTime.Now;

            if(invoiceDetail.ServiceFee < 0) invoiceDetail.ServiceFee = 0;

            if (invoiceDetail.Tip < 0) invoiceDetail.Tip = 0;
            

            if (this.Id.HasValue)
            {
                InvoiceDetailsService.UpdateInvoiceDetailService(invoiceDetail.InvoiceDetailId, invoiceDetail);
            }
            else
            {
                // add invoice detail 
                invoiceDetail.CreatedDatetime = DateTime.Now;
                invoiceDetail.InvoiceId = invoice.InvoiceId;
                // select customer service

                var newInvoiceDetailId = InvoiceDetailsService.AddInvoiceDetailService(invoiceDetail);

                ContainerStorage.SetSelectedRecordId("invoice", newInvoiceDetailId);

            }
            HandleBackButton();
        }
    }




}
